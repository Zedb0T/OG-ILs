(defun print-speedrun-end-results-text ((buf dma-buffer) (alpha float))
  (let* ((pb-time (get-pb-time))
         (pb-total-sec (the int pb-time))
         (lines-used 0)
         (pb-min (/ pb-total-sec 60))
         (pb-sec (- pb-total-sec (* pb-min 60)))
         (timer (the-as speedrun-timer (ppointer->process (-> *speedrun-manager* 0 timer))))
         (cur-total-sec (the int (-> timer recorded-time)))
         (cur-min (/ cur-total-sec 60))
         (cur-sec (- cur-total-sec (* cur-min 60))))
    ;; print mission header
    (clear *temp-string*)
    (clear *pc-encoded-temp-string*)
    (format *temp-string* "~4L~S~%" (-> *speedrun-category-names* (-> *speedrun-info* category)))
    (format *temp-string* "~6LMission Completed~%")
    (set! lines-used 3)
    (case (-> *speedrun-info* percent-warped?)
      (('minor)
        (format *temp-string* "~0LMinor Percentage Warp Used~%")
        (+! lines-used 1))
      (('major)
        (format *temp-string* "~3LMajor Percentage Warp Used!~%")
        (+! lines-used 1))
      )
    (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 256 84 0.0 (font-color default) (font-flags middle shadow kerning large))))
      (set! (-> font-ctx alpha) alpha)
      (set! (-> font-ctx scale) 0.5)
        (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
      (draw-string-adv *pc-encoded-temp-string* buf font-ctx))

    ;; print time
    (clear *temp-string*)
    (clear *pc-encoded-temp-string*)
    (format *temp-string* "~32LMission Time: ~0L~D:~2,'0D~%" cur-min cur-sec)
    (cond
      ;; NEW PB!
      ((= pb-time (-> timer recorded-time))
        (format *temp-string* "~14LNEW PERSONAL BEST!~0L~%~%")
        )
      ;; not a PB
      (else
        (format *temp-string* "~32LPersonal Best: ~0L~D:~2,'0D~%~%" pb-min pb-sec)
        )
      )
    (+! lines-used 2)
    (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 256 (+ 90 (* (- lines-used 2) 12)) 0.0 (font-color default) (font-flags middle shadow kerning large))))
      (set! (-> font-ctx alpha) alpha)
      (set! (-> font-ctx scale) 0.5)
      (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
      (draw-string-adv *pc-encoded-temp-string* buf font-ctx))
    
    ;; print stats
    (clear *temp-string*)
    (clear *pc-encoded-temp-string*)
    (format *temp-string* "~32LAverage Speed: ~0L~,,1fm/s~%~%" (/ (-> *speedrun-info* avg-speed) 4096.0))
    (print-jak-enemy-kill-stats (-> *statistics* kill-stats) *temp-string*)
    (let ((civ-kills (get-jak-friendly-kill-count (-> *statistics* kill-stats))))
      (when (nonzero? civ-kills)
        (format *temp-string* "~%~%~32LCivilians Killed: ~0L~D" civ-kills)))
    (format *temp-string* "~%~%")
    (print-kill-stats-awards (-> *statistics* kill-stats) *temp-string*)
    (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 256 (+ 90 (* lines-used 15)) 0.0 (font-color default) (font-flags middle shadow kerning large))))
      (set! (-> font-ctx alpha) alpha)
      (set! (-> font-ctx scale) 0.35)
      (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
      (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
      )
    )
  )

(defun play-music ((music-name symbol) (flava uint) (mode uint))
  ;; (set! (-> *progress-state-pc* music-player-track) info)
  (set-setting! 'music music-name 0.0 0)
  (set-setting! 'sound-flava #f 999999.0 flava)
  (set-setting! 'sound-mode #f 0.0 mode)
  (apply-settings *setting-control*)
  (sound-group-continue (sound-group music))
  (none)
  )

(defun fmt-timer-string (out (total-sec float))
  (let* ((minutes (/ (the int total-sec) 60))
         (sec (- total-sec (* minutes 60))))
    (if (> minutes 0)
      (if (>= sec 10) ;; too lazy to figure out zero padding for floats
        (format out "~D:~,,2f~%" minutes sec) ;; MM:SS.ms
        (format out "~D:0~,,2f~%" minutes sec) ;; MM:SS.ms
        )
      (format out "~,,2fs~%" total-sec) ;; SS.ms
      )
    )
  )

(define *last-target-trans* (new 'global 'vector))
(defmethod draw-timer ((this speedrun-timer))
  ;; (format 0 "draw-timer ~D~%" (get-current-time))
  (clear *temp-string*)
  (clear *pc-encoded-temp-string*)
  (cond
   ((-> this started?)
    (fmt-timer-string *temp-string* (* (the float (- (get-real-current-time) (-> this start-time))) 0.0033333334))
    )
   ((-> this stopped?)
    (fmt-timer-string *temp-string* (-> this recorded-time))
    )
   (else
    (fmt-timer-string *temp-string* 0.0)
    )
  )
  (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
  (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
    ;; reset bucket settings prior to drawing - font won't do this for us, and
    ;; draw-raw-image can sometimes mess them up. (intro sequence)
    (dma-buffer-add-gs-set-flusha buf (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)) (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
    (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 2 (if *display-sha* 396 406) 0.0 (font-color default) (font-flags shadow kerning large))))
      (set! (-> font-ctx scale) 0.25)
      (draw-string-adv *pc-encoded-temp-string* buf font-ctx)))

  ;; show speed in practice mode
  (clear *temp-string*)
  (clear *pc-encoded-temp-string*)
  (when (and *target*) ;; (-> *speedrun-info* practicing?))
    ;; compute our own velocity since xz-vel doesn't account for bonus velocity
    (let* ((true-vel (vector-! (new-stack-vector0) (-> *target* control trans) *last-target-trans*))
           (xz-vel (* 60.0 (sqrtf (+ (* (-> true-vel x) (-> true-vel x)) (* (-> true-vel z) (-> true-vel z)))))))
      (format *temp-string* "~,,1fm/s~%" (/ xz-vel 4096.0))
      (vector-copy! *last-target-trans* (-> *target* control trans))
      )
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
      ;; reset bucket settings prior to drawing - font won't do this for us, and
      ;; draw-raw-image can sometimes mess them up. (intro sequence)
      (dma-buffer-add-gs-set-flusha buf (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)) (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
      (let* ((y (if (and (-> *pc-settings* speedrunner-mode?) (-> *speedrun-info* display-run-info?)) 387 406))
            (font-ctx (new 'stack 'font-context *font-default-matrix* 510 y 0.0 (font-color default) (font-flags shadow kerning large right))))
        (set! (-> font-ctx scale) 0.25)
        (draw-string-adv *pc-encoded-temp-string* buf font-ctx)))
    )

  (none))

(defmethod start! ((this speedrun-timer))
  (set! (-> this started?) #t)
  (set! (-> this stopped?) #f)
  (set! (-> this start-time) (get-real-current-time))
  (set! (-> this end-time) 0)
  (none))

(defmethod reset! ((this speedrun-timer))
  (set! (-> this started?) #f)
  (set! (-> this stopped?) #f)
  (set! (-> this start-time) 0)
  (set! (-> this end-time) 0)
  (none))

(defmethod stop! ((this speedrun-timer))
  (when (not (-> this stopped?))
    (set! (-> this started?) #f)
    (set! (-> this stopped?) #t)
    (set! (-> this end-time) (get-real-current-time))
    (set! (-> this recorded-time) (* (the float (- (-> this end-time) (-> this start-time))) 0.0033333334))

    (maybe-update-best-time this)

    ;; spawn function to bring up end screen whenever we can
    (process-spawn-function process (lambda :behavior process ()
      (until (progress-allowed?)
        (suspend))
      (let ((timer (the-as speedrun-timer (ppointer->process (-> *speedrun-manager* 0 timer))))
            (tmp-music-name (-> *setting-control* user-current music))
            (tmp-flava (-> *setting-control* user-current sound-flava))
            (tmp-mode (-> *setting-control* user-current sound-mode)))
        ;; make sure user didnt manage to reset already
        (when (and timer (-> timer stopped?))
          (activate-progress *dproc* 'speedrun-end-results)
          (play-music 'race (the uint 0) (the uint 0))
          (print-stats (-> *statistics* kill-stats) #t)
          (until (progress-allowed?)
            (suspend))
          ;; stop race music, maybe resume old music
          (remove-setting! 'music)
          (apply-settings *setting-control*)
          (sound-group-pause (sound-group music))
          (when tmp-music-name
            (play-music tmp-music-name tmp-flava tmp-mode))
          )
        )
      ))
    )
  (-> this recorded-time))

(defmethod set-category! ((this speedrun-info) (category speedrun-category))
  (reset! (the-as speedrun-timer (ppointer->process (-> *speedrun-manager* 0 timer))))
  (set! (-> this category) category)
  (none))

(defmethod start-individual-level-run! ((this speedrun-info) (tsk game-task) (side-mish? symbol) (secrets game-secrets))
  (set! (-> this active-practice-objective end-task) tsk)
  (start 'play (get-continue-by-name *game-info* (play-task tsk 'debug 'play)))
  (set-master-mode 'game)
  ;; spawn a process that suspends until jak is properly spawned, before starting timer
  (process-spawn-function process (lambda :behavior process ((side-mish? symbol))
    (let ((target-continued? #f))
      (until (and target-continued?
                  (< (-> *game-info* blackout-time) (get-current-time)) 
                  (= (-> *setting-control* user-default bg-a-force) 0.0))
        ;; (if *target* (format 0 "target is in state ~A~%" (-> *target* next-state name)))
        (suspend)
        (when (and *target* (!= (-> *target* next-state name) 'target-continue))
          (true! target-continued?)))
      )
    (when side-mish?
      ;; post-game for side missions
      (task-close! "city-win-resolution"))
    ;; (set! (-> *game-info* secrets) secrets)
    (set-percent-warped! #f)
    (set! (-> *speedrun-info* avg-speed) 0.0)
    (start! (the-as speedrun-timer (ppointer->process (-> *speedrun-manager* 0 timer))))) side-mish?)
  (none)
  )

(define-extern reset-kill-stats (function none))
(defmethod start-run! ((this speedrun-info))
  ;; set garbage continue point so drill-mech-master and other shit won't be stupid
  (set! (-> *game-info* last-continue) *default-continue*)
  ;; reset guard level
  (let ((s5-0 *traffic-manager*)) 
    (send-event s5-0 'set-guard-target-level 0)
    (send-event s5-0 'set-max-alert-level 0)
    (send-event s5-0 'set-alert-level 0))
  ;; randomize game id so the autosplitter knows to restart
  (reset! *autosplit-info-jak2*)
  (reset-kill-stats)
  ;; turn on speedrun verification display
  (true! (-> this display-run-info?))
  ;; reset has-started? flag so we can flip it back to #t when jak touches ground/out of blackout
  (false! (-> *speedrun-info* has-started?))
  (send-event (ppointer->process *speedrun-manager*) 'start-run)
  ;; ensure any required settings are enabled
  (enforce-settings! this)
  ;; reset end-task 
  (set! (-> this active-practice-objective end-task) (game-task none))
  ;; finalize any category specific setup code
  (case (-> this category)
    (((speedrun-category newgame-normal))
      (initialize! *game-info* 'game (the-as game-save #f) "game-start")) 
    (((speedrun-category newgame-heromode))
      (initialize! *game-info* 'game (the-as game-save #f) "game-start-hero"))
    (((speedrun-category all-cheats-allowed))
      (initialize! *game-info* 'game (the-as game-save #f) "game-start"))
    ;; Act 1 ILs
    (((speedrun-category fortress-escape))
      (start-individual-level-run! this (game-task fortress-escape) #f (game-secrets)))
    (((speedrun-category city-help-kid))
      (start-individual-level-run! this (game-task city-help-kid) #f (game-secrets)))
    (((speedrun-category ruins-tower))
      (start-individual-level-run! this (game-task ruins-tower) #f (game-secrets)))
    (((speedrun-category atoll-water))
      (start-individual-level-run! this (game-task atoll-water) #f (game-secrets)))
    (((speedrun-category fortress-dump))
      (start-individual-level-run! this (game-task fortress-dump) #f (game-secrets)))
    (((speedrun-category city-krew-delivery))
      (start-individual-level-run! this (game-task city-krew-delivery) #f (game-secrets)))
    (((speedrun-category city-red-gun-training))
      (start-individual-level-run! this (game-task city-red-gun-training) #f (game-secrets)))
    (((speedrun-category atoll-sig))
      (start-individual-level-run! this (game-task atoll-sig) #f (game-secrets)))
    (((speedrun-category sewer-enemy))
      (start-individual-level-run! this (game-task sewer-enemy) #f (game-secrets)))
    (((speedrun-category strip-rescue))
      (start-individual-level-run! this (game-task strip-rescue) #f (game-secrets)))
    (((speedrun-category atoll-battle))
      (start-individual-level-run! this (game-task atoll-battle) #f (game-secrets)))
    (((speedrun-category mountain-lens))
      (start-individual-level-run! this (game-task mountain-lens) #f (game-secrets)))
    (((speedrun-category mountain-gear))
      (start-individual-level-run! this (game-task mountain-gear) #f (game-secrets)))
    (((speedrun-category mountain-shard))
      (start-individual-level-run! this (game-task mountain-shard) #f (game-secrets)))
    (((speedrun-category mountain-collection))
      (start-individual-level-run! this (game-task mountain-collection) #f (game-secrets)))
    (((speedrun-category city-keira-delivery))
      (start-individual-level-run! this (game-task city-keira-delivery) #f (game-secrets)))
    (((speedrun-category stadium-board1))
      (start-individual-level-run! this (game-task stadium-board1) #f (game-secrets)))
    (((speedrun-category city-krew-collection))
      (start-individual-level-run! this (game-task city-krew-collection) #f (game-secrets)))
    (((speedrun-category city-yellow-gun-training))
      (start-individual-level-run! this (game-task city-yellow-gun-training) #f (game-secrets)))
    (((speedrun-category drill-eggs))
      (start-individual-level-run! this (game-task drill-eggs) #f (game-secrets)))
    (((speedrun-category city-power))
