;; Phase 1 retail recording stress harness.
;;
;; This file is intentionally excluded from normal builds. To run it, uncomment
;; phase1-record-test.o in goal_src/jak3/dgos/game.gd, rebuild the iso group, and
;; boot the packed retail game. Comment the object out again after testing.
(in-package goal)

(define *phase1-record-test-started?* #f)

(defun phase1-global-used ()
  (&- (-> global current) (the-as uint (-> global base))))

(defun phase1-snapshot ((kind string) (cycle int))
  (format 0
          "PHASE1: SAMPLE ~S-~D global=~D active=~D pc=~D~%"
          kind
          cycle
          (phase1-global-used)
          (process-count *active-pool*)
          (process-count *pc-pool*))
  (none))

(defun phase1-wait-for-process ((name string) (timeout-seconds int))
  (let ((deadline (+ (get-current-time) (seconds timeout-seconds)))
        (found (the-as process #f)))
    (while (and (not found) (< (get-current-time) deadline))
      (set! found (process-by-name name *active-pool*))
      (when (not found)
        (suspend)))
    found))

(defun phase1-wait-for-recording ((minimum-samples int) (timeout-seconds int))
  (let ((deadline (+ (get-current-time) (seconds timeout-seconds))))
    (while (and
             (or (not (pc-replay-recording-active?))
                 (< (pc-replay-recording-count) minimum-samples))
             (< (get-current-time) deadline))
      (suspend))
    (and (pc-replay-recording-active?)
         (>= (pc-replay-recording-count) minimum-samples))))

(defun phase1-wait-for-recording-stop ((timeout-seconds int))
  (let ((deadline (+ (get-current-time) (seconds timeout-seconds))))
    (while (and (pc-replay-recording-active?)
                (< (get-current-time) deadline))
      (suspend))
    (not (pc-replay-recording-active?))))

(defun phase1-start-fast-mission ()
  (set-category! *speedrun-info*
    (speedrun-category wascity-bbush-get-to-18))
  (start-run! *speedrun-info*)
  (if (and
        (phase1-wait-for-process
          "wascity-bbush-get-to-18-resolution"
          30)
        (phase1-wait-for-recording 5 30))
      #t
      #f))

(defun phase1-record-test-run! ()
  (when (not *phase1-record-test-started?*)
    (set! *phase1-record-test-started?* #t)
    (process-spawn-function process
      :name "phase1-record-test"
      :to *pc-pool*
      :stack-size #x10000
      (lambda :behavior process ()
        (stack-size-set! (-> self main-thread) 2048)
        (let ((failed? #f)
              (baseline-global 0)
              (baseline-active 0)
              (baseline-pc 0)
              (max-global-growth 0))
          (format 0 "PHASE1: BEGIN bounded local recording retail stress~%")

          ;; Abort the fresh-boot scene, matching the cutscene-skip regression.
          (let ((deadline (+ (get-current-time) (seconds 30))))
            (while (and (not *scene-player*) (< (get-current-time) deadline))
              (suspend)))
          (cond
            (*scene-player*
             (send-event (ppointer->process *scene-player*) 'abort)
             (format 0 "PHASE1: PASS fresh-boot-cutscene-abort~%")
             (let ((deadline (+ (get-current-time) (seconds 10))))
               (while (and *scene-player* (< (get-current-time) deadline))
                 (suspend)))
             (dotimes (settle 180)
               (suspend)))
            (else
             (set! failed? #t)
             (format 0 "PHASE1: ERROR fresh-boot scene-player unavailable~%")))

          (let ((deadline (+ (get-current-time) (seconds 30))))
            (while (and (not *speedrun-manager*) (< (get-current-time) deadline))
              (suspend)))
          (cond
            ((not *speedrun-manager*)
             (set! failed? #t)
             (format 0 "PHASE1: ERROR speedrun manager unavailable~%"))
            (else
             ;; Warm the mission and native recorder before measuring cycles.
             (cond
               ((phase1-start-fast-mission)
                (replay-record-stop! #f)
                (format 0 "PHASE1: PASS recorder-warmup~%"))
               (else
                (set! failed? #t)
                (format 0 "PHASE1: ERROR recorder warmup failed~%")))

             (dotimes (settle 120)
               (suspend))
             (set! baseline-global (phase1-global-used))
             (set! baseline-active (process-count *active-pool*))
             (set! baseline-pc (process-count *pc-pool*))
             (phase1-snapshot "baseline" 0)

             ;; Repeatedly start, record, and exercise the start-run reset path.
             (dotimes (cycle 25)
               (cond
                 ((phase1-start-fast-mission)
                  (let ((before-reset (pc-replay-recording-count)))
                    (start-run! *speedrun-info*)
                    (format 0
                            "PHASE1: PASS reset-~D samples=~D~%"
                            (+ cycle 1)
                            before-reset))
                  (dotimes (settle 30)
                    (suspend))
                  (phase1-snapshot "reset" (+ cycle 1))
                  (set! max-global-growth
                        (max max-global-growth
                             (- (phase1-global-used) baseline-global))))
                 (else
                  (set! failed? #t)
                  (format 0 "PHASE1: ERROR reset-~D start failed~%" (+ cycle 1)))))

             ;; Save ten completed recorder attempts without opening the
             ;; interactive results screen between cycles.
             (dotimes (cycle 10)
               (cond
                 ((phase1-start-fast-mission)
                  (replay-record-stop! #t)
                  (if (phase1-wait-for-recording-stop 15)
                      (format 0
                              "PHASE1: PASS complete-save-~D~%"
                              (+ cycle 1))
                      (begin
                        (set! failed? #t)
                        (format 0
                                "PHASE1: ERROR complete-save-~D recorder stayed active~%"
                                (+ cycle 1))))
                  (dotimes (settle 30)
                    (suspend))
                  (phase1-snapshot "complete" (+ cycle 1))
                  (set! max-global-growth
                        (max max-global-growth
                             (- (phase1-global-used) baseline-global))))
                 (else
                  (set! failed? #t)
                  (format 0
                          "PHASE1: ERROR complete-~D start failed~%"
                          (+ cycle 1)))))

             ;; Exercise the real mission-completion hook once at the end. Do
             ;; not suspend after it: the normal results screen intentionally
             ;; pauses PC processes after the completion event is handled.
             (cond
               ((phase1-start-fast-mission)
                (let ((manager
                        (process-by-name
                          "wascity-bbush-get-to-18-resolution"
                          *active-pool*)))
                  (cond
                    (manager
                     (send-event manager 'complete)
                     (if (phase1-wait-for-recording-stop 15)
                         (format 0 "PHASE1: PASS actual-mission-completion~%")
                         (begin
                           (set! failed? #t)
                           (format 0 "PHASE1: ERROR actual completion stayed active~%"))))
                    (else
                     (set! failed? #t)
                     (format 0 "PHASE1: ERROR actual completion manager unavailable~%")))))
               (else
                (set! failed? #t)
                (format 0 "PHASE1: ERROR actual completion start failed~%")))

             (replay-record-stop! #f)
             (when (!= (process-count *pc-pool*) baseline-pc)
               (set! failed? #t)
               (format 0
                       "PHASE1: ERROR pc process growth baseline=~D current=~D~%"
                       baseline-pc
                       (process-count *pc-pool*)))
             (when (> (process-count *active-pool*) (+ baseline-active 12))
               (set! failed? #t)
               (format 0
                       "PHASE1: ERROR active process growth baseline=~D current=~D~%"
                       baseline-active
                       (process-count *active-pool*)))
             (when (> max-global-growth #x100000)
               (set! failed? #t)
               (format 0
                       "PHASE1: ERROR global growth exceeded limit: ~D~%"
                       max-global-growth))
             (format 0 "PHASE1: MAX global-growth=~D~%" max-global-growth)))

          (if failed?
              (format 0 "PHASE1: RESULT FAIL~%")
              (format 0 "PHASE1: RESULT PASS~%"))))))
  (none))

(phase1-record-test-run!)
