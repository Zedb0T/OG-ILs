;;-*-Lisp-*-
(in-package goal)

;; Bounded local replay recording and lifecycle integration for one local PB
;; ghost. The drawable itself lives in replay-ghost.gc.

(define-extern pc-replay-recording-start (function time-frame string symbol))
(define-extern pc-replay-recording-sample
  (function time-frame vector vector vector symbol))
(define-extern pc-replay-recording-sample-metadata
  (function string string uint collide-status symbol))
(define-extern pc-replay-recording-sample-extra
  (function string vector vector vector symbol))
(define-extern pc-replay-recording-sample-extra-animation
  (function string uint symbol))
(define-extern pc-replay-recording-finish (function symbol symbol))
(define-extern pc-replay-recording-active? (function symbol))
(define-extern pc-replay-recording-count (function int))
(define-extern replay-ghost-start! (function none))
(define-extern replay-ghost-stop! (function none))
(define-extern replay-ghost-update! (function none))
(define-extern replay-player-ping-update! (function none))
(define-extern *replay-ghost-stress-active?* symbol)

(defun replay-record-extra! ((extra process-drawable))
  "Attach one separately rendered player mount to the most recent sample."
  (when (and extra
             (nonzero? (-> extra root))
             (nonzero? (-> extra draw))
             (nonzero? (-> extra draw art-group)))
    (let ((animation-name "")
          (animation-frame 0.0))
      (when (and (nonzero? (-> extra skel))
                 (> (-> extra skel active-channels) 0))
        (let* ((channel (-> extra skel root-channel 0))
               (animation (-> channel frame-group)))
          (when (and animation
                     (nonzero? animation)
                     (= (-> animation type) art-joint-anim))
            (set! animation-name (-> animation name))
            (set! animation-frame (-> channel frame-num)))))
      (when (pc-replay-recording-sample-extra
        (-> extra draw art-group name)
        (-> extra root trans)
        (the-as vector (-> extra root quat))
        (-> extra root scale))
        (pc-replay-recording-sample-extra-animation
          animation-name
          (the-as uint animation-frame)))))
  (none))

(defun replay-record-start! ((start-time time-frame))
  "Start on the canonical IL timer edge with the timer's exact clock origin."
  (when *replay-ghost-stress-active?* (return #f))
  ;; A mission's built-in retry can restart the timer without passing through
  ;; speedrun-info.start-run!. Close any surviving attempt here as a final
  ;; lifecycle boundary, then replace its drawable and playback snapshot.
  (replay-ghost-stop!)
  (when (pc-replay-recording-active?)
    (pc-replay-recording-finish #f))
  (when (pc-replay-recording-start
          start-time
          (enum->string speedrun-category (-> *speedrun-info* category)))
    (replay-ghost-start!))
  (none))

(defun replay-record-frame! ()
  "Capture one bounded sample. All native storage is allocated once and reused."
  (when *replay-ghost-stress-active?* (return #f))
  ;; The speedrun manager continues updating through pause/menu modes. Use it
  ;; to retire streamed-art references before those modes can invalidate a
  ;; ghost animation channel, then restore playback at the current sample when
  ;; normal gameplay resumes.
  (replay-player-ping-update!)
  (replay-ghost-update!)
  (when (and (pc-replay-recording-active?)
             *target*
             (-> *target* control))
    (let* ((ctrl (-> *target* control))
           (state-name
             (if (-> *target* next-state)
                 (symbol->string (-> *target* next-state name))
                 "none")))
      (pc-replay-recording-sample
        (get-real-current-time)
        (-> ctrl trans)
        (the-as vector (-> ctrl quat))
        (-> ctrl transv))
      ;; Copy the base animation name and exact channel frame into native-owned
      ;; sample storage immediately. No streamed art pointer crosses this call
      ;; or survives a mission transition.
      (let ((animation-name "")
            (animation-frame 0.0))
        (when (and (nonzero? (-> *target* skel))
                   (> (-> *target* skel active-channels) 0))
          (let* ((channel (-> *target* skel root-channel 0))
                 (animation (-> channel frame-group)))
            (when (and animation
                       (nonzero? animation)
                       (= (-> animation type) art-joint-anim))
              (set! animation-name (-> animation name))
              (set! animation-frame (-> channel frame-num)))))
        (pc-replay-recording-sample-metadata
          state-name
          animation-name
          (the-as uint animation-frame)
          (-> ctrl status)))
      ;; Jak's board, mech shell, and piloted vehicles are independent
      ;; process-drawables. Persist the active one's own transform/art so the
      ;; replay does not have to guess it from Jak's state string.
      (cond
        ((and (focus-test? *target* mech flut)
              (-> *target* manipy))
         (replay-record-extra!
           (the-as process-drawable
             (ppointer->process (-> *target* manipy)))))
        ((and (focus-test? *target* pilot)
              (nonzero? (-> *target* pilot))
              (nonzero? (-> *target* pilot vehicle)))
         (let ((vehicle (handle->process (-> *target* pilot vehicle))))
           (when vehicle
             (replay-record-extra! (the-as process-drawable vehicle)))))
        ((and (focus-test? *target* board)
              (nonzero? (-> *target* board))
              (-> *target* board board))
         (replay-record-extra!
           (the-as process-drawable (-> *target* board board 0)))))))
  (none))

(defun replay-record-stop! ((completed? symbol))
  "Atomically save the attempt if recording is active."
  (when *replay-ghost-stress-active?* (return #f))
  ;; The ghost skeleton references current level art. Always destroy it before
  ;; any finish/reset/failure path can begin unloading that art.
  (replay-ghost-stop!)
  (when (pc-replay-recording-active?)
    (pc-replay-recording-finish completed?))
  (none))
