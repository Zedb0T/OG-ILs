;;-*-Lisp-*-
(in-package goal)

;; Ghost recorder + playback for Individual Level (IL) runs.
;;
;; While an IL run is active, we sample the player's position/orientation/velocity/
;; animation/state every frame into an in-memory buffer. When the run completes we:
;;   - dump the samples to a JSON file (out/<data>/ghost/ghost-<category>.json), and
;;   - pin the first completed run until explicitly cleared, so later attempts
;;     cannot overwrite the replay while ghost processes are still reading it.
;;
;; Double-buffered: `play-samples` holds the pinned run being watched, `rec-samples`
;; remains scratch space for every later attempt. The buffers swap only when there is
;; no pinned replay and a run completes.
;;
;; Integration hooks live in speedruns.gc:
;;   - ghost-on-run-start!     : called when an IL run begins (spawns ghost + starts recording)
;;   - ghost-record-frame!     : called every frame from (update! *speedrun-info*)
;;   - ghost-stop-recording!   : called when the timer stops (run completed)
;;   - ghost-discard-recording!: called when a run is reset (abandons the in-progress recording)
;;
;; Manual controls (REPL): (ghost-play), (ghost-stop-playback), (ghost-clear-replay!).

(define-extern *mod-version-text* string)

;; how many frames we can hold. 18000 = 5 minutes @ 60fps. covers essentially every IL.
(defconstant GHOST_MAX_FRAMES 18000)

;; Up to 33 independently-selected server replays race on their recorded lines.
(defconstant GHOST_MAX_PLAYERS 33)

;; Imported packs must not consume the permanent global heap. This heap is
;; reset whenever a new pack becomes ready, so changing modes or selections
;; cannot leak another copy of every replay. The C++ BIG_MEMORY layout reserves
;; the corresponding additional address space before the debug heap.
(defconstant GHOST_REPLAY_HEAP_SIZE #x800000)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Types
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(deftype ghost-sample (structure)
  "A single recorded frame of player state. Stored inline in a big array."
  ((pos        vector       :inline)  ;; world position (game units)
   (quat       quaternion   :inline)  ;; orientation
   (transv     vector       :inline)  ;; velocity (game units)
   (anim-idx   int32)                 ;; index of the base anim within the jak art-group (stable across reloads); -1 = none
   (anim-frame float)                 ;; base-channel frame-num
   (state      symbol)                ;; target's current state name
   (status     uint32)                ;; collide-status flags
   (xz-vel     float)                 ;; horizontal speed
   ))

(deftype ghost-recording (basic)
  "Double-buffered recording state: one buffer is pinned while the other records."
  ((rec-samples  (inline-array ghost-sample))  ;; run currently being recorded
   (play-samples (inline-array ghost-sample))  ;; pinned completed run (the ghost)
   (capacity     int32)
   (rec-count    int32)
   (play-count   int32)
   (recording?   symbol)
   (have-ghost?  symbol)                        ;; a completed run is available to replay
   (category     speedrun-category)             ;; category the ghost was recorded on
   (start-time   time-frame)
   (last-anim    art-joint-anim)                ;; cache: last frame-group seen while recording
   (last-anim-idx int32)                        ;; cache: its resolved art-group index
   ))

(deftype ghost-replay (basic)
  "One imported JSON replay and its independently-owned sample buffer."
  ((samples (inline-array ghost-sample))
   (count   int32)))

(deftype ghost-json-reader (structure)
  "Cursor used by the small parser for ghost JSON files."
  ((data   (pointer uint8))
   (pos    int32)
   (length int32)))

(define-extern *ghost-recording* ghost-recording)
(define-extern ghost-stop-playback (function none))
(define-extern ghost-spawn-playback! (function none))

(deftype ghost-player (process-drawable)
  "A translucent replay of a recorded IL run using the real Jak model."
  ((idx      int32)
   (frames   int32)
   (samples  (inline-array ghost-sample))         ;; points at the pinned playback buffer
   (offset   vector :inline)
   (runner-name string)
   (runner-font font-context)
   (runner-screen vector4w :inline)
   (runner-on-screen? symbol))
  (:state-methods
   idle))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Globals
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; master switch for automatic recording during IL runs
(define *ghost-record-enabled?* #t)

;; the recording buffers (allocated once, reused every run)
(define *ghost-recording* (new 'global 'ghost-recording))
(set! (-> *ghost-recording* rec-samples) (new 'global 'inline-array 'ghost-sample GHOST_MAX_FRAMES))
(set! (-> *ghost-recording* play-samples) (new 'global 'inline-array 'ghost-sample GHOST_MAX_FRAMES))
(set! (-> *ghost-recording* capacity) GHOST_MAX_FRAMES)
(set! (-> *ghost-recording* rec-count) 0)
(set! (-> *ghost-recording* play-count) 0)
(set! (-> *ghost-recording* recording?) #f)
(set! (-> *ghost-recording* have-ghost?) #f)

;; Tunable from the REPL for smaller tests. The pool still caps this at 33.
(define *ghost-playback-count* GHOST_MAX_PLAYERS)
(define *ghost-playback-spacing* (meters 1.5))

;; Replays selected in the in-game Replay Server menu.
(define *ghost-replays* (new 'global 'boxed-array ghost-replay GHOST_MAX_PLAYERS))
(define *ghost-replay-count* 0)
(define *ghost-replay-category* (the-as speedrun-category -1))
(define *ghost-replay-generation* 0)
(kheap-alloc (define *ghost-replay-heap* (new 'global 'kheap)) GHOST_REPLAY_HEAP_SIZE)

;; One-way latch for the current attempt. Mission scripts can briefly put Jak
;; back into target-grab later, so playback must only wait for the initial
;; release of player control and never pause again after the race has begun.
(define *ghost-race-released?* #f)

;; A five-minute 60 fps replay can exceed 2.5 MiB. Reusing one 4 MiB read
;; buffer avoids retaining a second full copy after each replay is decoded.
(define *ghost-json-buffer* (new 'global 'string #x400000 (the-as string #f)))
(define *ghost-json-token* (new 'global 'string 128 (the-as string #f)))
(define *ghost-json-path* (new 'global 'string 256 (the-as string #f)))
(define *ghost-json-count-key* "\"count\"")
(define *ghost-json-frames-key* "\"frames\"")

;; A manipy rendering the same character fits in a #x20000 process. Keeping a
;; fixed pool of 33 avoids consuming the shared variable-sized process heap.
(define *ghost-dead-pool* (new 'global 'dead-pool GHOST_MAX_PLAYERS #x20000 "*ghost-dead-pool*"))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; JSON replay import
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun ghost-json-number-char? ((c uint))
  (or (and (>= c #x30) (<= c #x39))
      (= c #x2d) ;; -
      (= c #x2b) ;; +
      (= c #x2e) ;; .
      (= c #x45) ;; E
      (= c #x65))) ;; e

(defun ghost-json-seek-key! ((reader ghost-json-reader) (key string))
  "Move reader just after key."
  (while (< (-> reader pos) (-> reader length))
    (when (charp-prefix= (-> key data) (&-> (-> reader data) (-> reader pos)))
      (+! (-> reader pos) (length key))
      (return #t))
    (+! (-> reader pos) 1))
  #f)

(defun ghost-json-read-number-token! ((reader ghost-json-reader))
  "Read the next JSON number into the shared token string."
  (while (and (< (-> reader pos) (-> reader length))
              (not (ghost-json-number-char? (-> reader data (-> reader pos)))))
    (+! (-> reader pos) 1))
  (let ((out (-> *ghost-json-token* data))
        (n 0))
    (while (and (< (-> reader pos) (-> reader length))
                (ghost-json-number-char? (-> reader data (-> reader pos)))
                (< n 127))
      (set! (-> out n) (-> reader data (-> reader pos)))
      (+! n 1)
      (+! (-> reader pos) 1))
    (set! (-> out n) 0))
  *ghost-json-token*)

(defun ghost-json-read-string! ((reader ghost-json-reader))
  "Read the next unescaped JSON string into the shared token string."
  (while (and (< (-> reader pos) (-> reader length))
              (!= (-> reader data (-> reader pos)) #x22))
    (+! (-> reader pos) 1))
  (+! (-> reader pos) 1)
  (let ((out (-> *ghost-json-token* data))
        (n 0))
    (while (and (< (-> reader pos) (-> reader length))
                (!= (-> reader data (-> reader pos)) #x22)
                (< n 127))
      (set! (-> out n) (-> reader data (-> reader pos)))
      (+! n 1)
      (+! (-> reader pos) 1))
    (set! (-> out n) 0)
    (+! (-> reader pos) 1))
  *ghost-json-token*)

(defun ghost-alloc-replay! ((count int))
  "Allocate an imported replay from the resettable replay heap."
  ;; `new` only accepts the compiler's built-in allocation names. Temporarily
  ;; point its process-level allocation slot at our private heap, allocate both
  ;; objects without yielding, then restore the engine's original heap.
  (let ((old-process-level-heap process-level-heap))
    (set! process-level-heap *ghost-replay-heap*)
    (let ((replay (new 'process-level-heap 'ghost-replay)))
      (set! (-> replay samples)
            (new 'process-level-heap 'inline-array 'ghost-sample count))
      (set! (-> replay count) count)
      (set! process-level-heap old-process-level-heap)
      replay)))

(defun ghost-load-json-replay! ((filename string))
  "Load one exported ghost JSON file into an independent replay buffer."
  (let ((file (new 'stack 'file-stream filename 'read)))
    (when (not (file-stream-valid? file))
      (return (the-as ghost-replay #f)))
    (let ((file-size (length file)))
      (when (>= file-size (-> *ghost-json-buffer* allocated-length))
        (file-stream-close file)
        (format 0 "ghost: JSON too large: ~S (~D bytes)~%" filename file-size)
        (return (the-as ghost-replay #f)))
      (clear *ghost-json-buffer*)
      (let ((read-size (file-stream-read file (-> *ghost-json-buffer* data) file-size)))
        (file-stream-close file)
        (set! (-> *ghost-json-buffer* data read-size) 0)
        (let ((reader (new 'stack 'ghost-json-reader)))
          (set! (-> reader data) (-> *ghost-json-buffer* data))
          (set! (-> reader pos) 0)
          (set! (-> reader length) read-size)
          (when (not (ghost-json-seek-key! reader *ghost-json-count-key*))
            (return (the-as ghost-replay #f)))
          (let ((count (min GHOST_MAX_FRAMES (string->int (ghost-json-read-number-token! reader)))))
            (when (or (<= count 0)
                      (not (ghost-json-seek-key! reader *ghost-json-frames-key*)))
              (return (the-as ghost-replay #f)))
            (let* ((bytes-needed (+ (* count (size-of ghost-sample))
                                    (size-of ghost-replay)
                                    #x40))
                   (heap-free (&- (-> *ghost-replay-heap* top)
                                  (the-as uint (-> *ghost-replay-heap* current)))))
              (when (> bytes-needed heap-free)
                (format 0 "ghost: replay heap full; skipping ~S (~D frames, ~D bytes free)~%"
                        filename
                        count
                        heap-free)
                (return (the-as ghost-replay #f)))
            (let ((replay (ghost-alloc-replay! count)))
              (dotimes (i count)
                (let ((sample (-> replay samples i)))
                  ;; time
                  (ghost-json-read-number-token! reader)
                  ;; position (JSON is meters; GOAL transforms use 4096 units/meter)
                  (set! (-> sample pos x) (* (string->float (ghost-json-read-number-token! reader)) 4096.0))
                  (set! (-> sample pos y) (* (string->float (ghost-json-read-number-token! reader)) 4096.0))
                  (set! (-> sample pos z) (* (string->float (ghost-json-read-number-token! reader)) 4096.0))
                  (set! (-> sample pos w) 1.0)
                  ;; root quaternion
                  (set! (-> sample quat x) (string->float (ghost-json-read-number-token! reader)))
                  (set! (-> sample quat y) (string->float (ghost-json-read-number-token! reader)))
                  (set! (-> sample quat z) (string->float (ghost-json-read-number-token! reader)))
                  (set! (-> sample quat w) (string->float (ghost-json-read-number-token! reader)))
                  ;; velocity and remaining numeric state
                  (set! (-> sample transv x) (* (string->float (ghost-json-read-number-token! reader)) 4096.0))
                  (set! (-> sample transv y) (* (string->float (ghost-json-read-number-token! reader)) 4096.0))
                  (set! (-> sample transv z) (* (string->float (ghost-json-read-number-token! reader)) 4096.0))
                  (set! (-> sample transv w) 0.0)
                  (set! (-> sample xz-vel) (* (string->float (ghost-json-read-number-token! reader)) 4096.0))
                  (set! (-> sample status) (the-as uint32 (string->int (ghost-json-read-number-token! reader))))
                  (set! (-> sample anim-frame) (string->float (ghost-json-read-number-token! reader)))
                  ;; Keep the target state so playback can synchronize forced
                  ;; mission-start states (such as target-grab) with the live Jak.
                  (ghost-json-read-string! reader)
                  (set! (-> sample state) (string->symbol *ghost-json-token*))
                  ;; Resolve the exported animation name against the loaded Jak art.
                  (ghost-json-read-string! reader)
                  (set! (-> sample anim-idx)
                        (if (and *target* (nonzero? (-> *target* draw)))
                            (get-art-idx-by-name-method
                              (-> *target* draw art-group)
                              *ghost-json-token*
                              art-joint-anim)
                            -1))))
              replay))))))))

(defun ghost-load-json-pack! ((category speedrun-category))
  "Load every replay selected in the native menu for this mission."
  (let* ((cat-name (enum->string speedrun-category category))
         (generation (pc-replay-prepare-selected cat-name))
         (selected-count (pc-replay-selected-count)))
    (when (= generation 0)
      (set! *ghost-replay-count* 0)
      (set! *ghost-replay-generation* 0)
      (return 0))
    (when (and (> *ghost-replay-count* 0)
               (= *ghost-replay-category* category)
               (= *ghost-replay-generation* generation))
      (return *ghost-replay-count*))
    ;; No active player may retain pointers into the pack while its heap is
    ;; reset. Mission transitions normally clear them, but manual replay/mode
    ;; changes can reload a pack while remaining in the same level.
    (ghost-stop-playback)
    (kheap-reset *ghost-replay-heap*)
    (set! *ghost-replay-count* 0)
    (set! *ghost-replay-category* category)
    (set! *ghost-replay-generation* generation)
    (dotimes (i (min selected-count GHOST_MAX_PLAYERS))
      (format (clear *ghost-json-path*) "ghost/selected-replay-~D.json" i)
      (let ((replay (ghost-load-json-replay! *ghost-json-path*)))
        (when replay
          (set! (-> *ghost-replays* *ghost-replay-count*) replay)
          (+! *ghost-replay-count* 1))))
    (when (> *ghost-replay-count* 0)
      (format 0 "ghost: loaded ~D selected replays for ~S~%"
              *ghost-replay-count*
              cat-name))
    (return *ghost-replay-count*)))

(defun ghost-load-local-stress-pack! ((category speedrun-category))
  "Reload the downloaded replay files without consulting the network bridge.
   This is only used by the memory regression harness, so the test still runs
   when its boot-time server refresh has not completed."
  (ghost-stop-playback)
  (kheap-reset *ghost-replay-heap*)
  (set! *ghost-replay-count* 0)
  (set! *ghost-replay-category* category)
  (set! *ghost-replay-generation* 1)
  (dotimes (i GHOST_MAX_PLAYERS)
    (format (clear *ghost-json-path*) "ghost/selected-replay-~D.json" i)
    (when (pc-filepath-exists? *ghost-json-path*)
      (let ((replay (ghost-load-json-replay! *ghost-json-path*)))
        (when replay
          (set! (-> *ghost-replays* *ghost-replay-count*) replay)
          (+! *ghost-replay-count* 1)))))
  (return *ghost-replay-count*))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Recording
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun ghost-control-locked-state? ((state symbol))
  "States used while a mission owns Jak and player movement is unavailable."
  (or (= state 'target-grab)
      (= state 'target-grab-ride)
      (= state 'target-continue)))

(defun ghost-cancel-playback-waiters! ()
  "Remove delayed replay work left behind by the previous attempt."
  (kill-by-name "ghost-safe-spawn-wait" *pc-pool*)
  (kill-by-name "ghost-server-wait" *pc-pool*)
  (none))

(defun ghost-start-recording! ()
  "Begin a fresh recording for the current speedrun category."
  (ghost-cancel-playback-waiters!)
  (set! *ghost-race-released?* #f)
  (when *ghost-record-enabled?*
    ;; Release archives may not contain an empty ghost directory. Ensure it
    ;; exists before the first completed or unfinished replay is written.
    (pc-mkdir-file-path "ghost/replay.json")
    (set! (-> *ghost-recording* rec-count) 0)
    (set! (-> *ghost-recording* recording?) #t)
    (set! (-> *ghost-recording* last-anim) (the-as art-joint-anim #f))
    (set! (-> *ghost-recording* last-anim-idx) -1)
    (set! (-> *ghost-recording* start-time) (get-real-current-time)))
  (none))

(defun ghost-record-frame! ()
  "Capture one frame of player state. Safe to call every frame; no-ops unless recording."
  (when (and (-> *ghost-recording* recording?)
             *target*
             (nonzero? (-> *target* skel))
             (< (-> *ghost-recording* rec-count) (-> *ghost-recording* capacity)))
    ;; Latch the first transition to a player-controlled state. Do not derive
    ;; this from Jak every playback frame: some mission states reuse
    ;; target-grab after the start and would otherwise freeze a ghost mid-run.
    (when (and (not *ghost-race-released?*)
               (-> *target* next-state)
               (not (ghost-control-locked-state? (-> *target* next-state name))))
      (set! *ghost-race-released?* #t))
    (let ((s (-> *ghost-recording* rec-samples (-> *ghost-recording* rec-count)))
          (ctrl (-> *target* control))
          (ch (-> *target* skel root-channel 0)))
      (vector-copy! (-> s pos) (-> ctrl trans))
      ;; The visible Jak skeleton is rooted from control.trans as a transformq, so
      ;; record control.quat (the render/root quaternion), not quat-for-control
      ;; (the gameplay-facing heading quaternion).
      (vector-copy! (the-as vector (-> s quat)) (the-as vector (-> ctrl quat)))
      (vector-copy! (-> s transv) (-> ctrl transv))
      ;; resolve the current base anim to a stable art-group index (cached per anim)
      (let ((fg (-> ch frame-group)))
        (cond
          ((= fg (-> *ghost-recording* last-anim))
           (set! (-> s anim-idx) (-> *ghost-recording* last-anim-idx)))
          ((and fg (nonzero? fg) (nonzero? (-> *target* draw)))
           (let ((idx (get-art-idx-by-name-method (-> *target* draw art-group) (-> fg name) art-joint-anim)))
             (set! (-> s anim-idx) idx)
             (set! (-> *ghost-recording* last-anim) fg)
             (set! (-> *ghost-recording* last-anim-idx) idx)))
          (else
           (set! (-> s anim-idx) -1))))
      (set! (-> s anim-frame) (-> ch frame-num))
      (set! (-> s state) (if (-> *target* next-state) (-> *target* next-state name) #f))
      (set! (-> s status) (the-as uint32 (-> ctrl status)))
      (set! (-> s xz-vel) (-> ctrl ctrl-xz-vel)))
    (+! (-> *ghost-recording* rec-count) 1))
  (none))

(defun ghost-write-json! ((samples (inline-array ghost-sample)) (cnt int) (category speedrun-category) (time-seconds float) (new-best? symbol) (completed? symbol))
  "Dump a completed or interrupted recording to a JSON file for external tools."
  (let ((cat-name (enum->string speedrun-category category)))
    ;; build the output path
    (format (clear *temp-string*) "ghost/ghost-~S.json" cat-name)
    (let ((file (new 'stack 'file-stream *temp-string* 'write)))
      (when (>= (-> file file) 0)
        ;; header
        (format file "{~%")
        (format file "  \"version\": 1,~%")
        (format file "  \"category\": \"~S\",~%" cat-name)
        (format file "  \"mod_version\": \"~S\",~%" *mod-version-text*)
        (format file "  \"time_seconds\": ~f,~%" time-seconds)
        (format file "  \"percent_warped\": ~D,~%" (if (= (-> *speedrun-info* percent-warped?) 'major) 1 0))
        (format file "  \"vehicle_name\": \"~S\",~%" (get-override-vehicle-name))
        (format file "  \"is_personal_best\": ~S,~%" (if new-best? "true" "false"))
        (format file "  \"completed\": ~S,~%" (if completed? "true" "false"))
        (format file "  \"fps\": 60,~%")
        (format file "  \"count\": ~D,~%" cnt)
        (format file "  \"units\": \"meters\",~%")
        (format file "  \"keys\": [\"t\",\"px\",\"py\",\"pz\",\"qx\",\"qy\",\"qz\",\"qw\",\"vx\",\"vy\",\"vz\",\"xzvel\",\"status\",\"frame\",\"state\",\"anim\"],~%")
        (format file "  \"frames\": [~%")
        ;; frames
        (dotimes (i cnt)
          (let ((s (-> samples i))
                (t (/ (the float i) 60.0)))
            (when (> i 0)
              (format file ",~%"))
            (format file "    [~f,~f,~f,~f," t (/ (-> s pos x) 4096.0) (/ (-> s pos y) 4096.0) (/ (-> s pos z) 4096.0))
            (format file "~f,~f,~f,~f," (-> s quat x) (-> s quat y) (-> s quat z) (-> s quat w))
            (format file "~f,~f,~f,~f," (/ (-> s transv x) 4096.0) (/ (-> s transv y) 4096.0) (/ (-> s transv z) 4096.0) (/ (-> s xz-vel) 4096.0))
            (format file "~D,~f," (-> s status) (-> s anim-frame))
            (format file "\"~S\",\"~S\"]"
                    (if (-> s state) (-> s state) 'none)
                    ;; resolve the anim index to a name via the currently-loaded jak art
                    (if (and *target* (nonzero? (-> *target* draw)) (>= (-> s anim-idx) 0)
                             (< (-> s anim-idx) (-> *target* draw art-group length)))
                        (-> (the-as art-element (-> *target* draw art-group data (-> s anim-idx))) name)
                        "none"))))
        (format file "~%  ]~%}~%")
        (file-stream-close file)
        (format 0 "ghost: wrote ~D frames to ~S~%" cnt *temp-string*))))
  (none))

(defun ghost-publish-recording! ((category speedrun-category))
  "Publish after the mission-completion call stack has returned to the scheduler."
  (process-spawn-function process :to *pc-pool* :name "ghost-replay-publish"
    (lambda :behavior process ((category speedrun-category))
      (stack-size-set! (-> self main-thread) 1024)
      (suspend)
      (let ((cat-name (enum->string speedrun-category category)))
        (format (clear *ghost-json-path*) "ghost/ghost-~S.json" cat-name)
        (pc-replay-publish *ghost-json-path*)))
    category)
  (none))

(defun ghost-discard-recording! ()
  "Publish an interrupted recording as the last attempt, then clear the recorder."
  (ghost-cancel-playback-waiters!)
  ;; Replay players live in the persistent PC pool. Remove them before a retry
  ;; can unload the mission art their skeletons reference.
  (ghost-stop-playback)
  (when (and (-> *ghost-recording* recording?)
             (> (-> *ghost-recording* rec-count) 0))
    (let* ((category (-> *speedrun-info* category))
           (count (-> *ghost-recording* rec-count))
           (time-seconds
             (* (the float (- (get-real-current-time)
                              (-> *ghost-recording* start-time)))
                0.0033333334)))
      (ghost-write-json! (-> *ghost-recording* rec-samples)
                         count category time-seconds #f #f)
      (ghost-publish-recording! category)
      (format 0 "ghost: uploaded unfinished attempt (~D frames)~%" count)))
  (set! (-> *ghost-recording* recording?) #f)
  (set! (-> *ghost-recording* rec-count) 0)
  (none))

(defun ghost-stop-recording! ((time-seconds float) (new-best? symbol))
  "Finish recording and publish a new personal best to the local replay server."
  (ghost-cancel-playback-waiters!)
  ;; This must happen for every finish, not only PBs. Mission completion unloads
  ;; the current level/art before the next attempt; a persistent ghost retaining
  ;; that art otherwise enters process-drawable-art-error on the retry.
  (ghost-stop-playback)
  (when (-> *ghost-recording* recording?)
    (set! (-> *ghost-recording* recording?) #f)
    (when (> (-> *ghost-recording* rec-count) 0)
      (let ((category (-> *speedrun-info* category))
            (count (-> *ghost-recording* rec-count)))
        ;; Every completed attempt goes to the replay server. Only a PB is eligible
        ;; for Speedrun.com submission and replaces the pinned local PB ghost.
        (ghost-write-json! (-> *ghost-recording* rec-samples) count category time-seconds new-best? #t)
        (cond
          (new-best?
         ;; Playback is already stopped above, so the old source buffer can now
         ;; be replaced safely by the completed PB.
           (let ((tmp (-> *ghost-recording* rec-samples)))
             (set! (-> *ghost-recording* rec-samples) (-> *ghost-recording* play-samples))
             (set! (-> *ghost-recording* play-samples) tmp))
           (set! (-> *ghost-recording* play-count) count)
           (set! (-> *ghost-recording* category) category)
           (set! (-> *ghost-recording* have-ghost?) #t))
          (else
           (format 0 "ghost: uploaded completed attempt; not a new personal best~%")))
        ;; Mission completion runs inside speedrun-timer.stop!. Defer the native
        ;; JSON/network bridge until that call stack has unwound; release builds
        ;; otherwise terminate at the bridge before the upload job is queued.
        (ghost-publish-recording! category))))
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Playback
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstate idle (ghost-player)
  :virtual #t
  :trans
  (behavior ()
    ;; The root transform is at Jak's feet, so a positive screen-space y offset
    ;; places the runner name directly underneath the replay model.
    (set! (-> self runner-on-screen?)
          (transform-point-qword! (-> self runner-screen) (-> self root trans)))
    (when (-> self runner-on-screen?)
      (set-origin! (-> self runner-font)
                   (+ (/ (-> self runner-screen x) 16) -1792)
                   (+ (/ (-> self runner-screen y) 16) -1837))
      (set-depth! (-> self runner-font) (/ (-> self runner-screen z) 16))))
  :code
  (behavior ()
    (until #f
      (when (> (-> self frames) 0)
        (let* ((cnt (-> self frames))
               (i (-> self idx))
               (s (-> self samples i)))
          ;; drive root transform straight from the recording
          (vector-copy! (-> self root trans) (-> s pos))
          (+! (-> self root trans x) (-> self offset x))
          (+! (-> self root trans y) (-> self offset y))
          (+! (-> self root trans z) (-> self offset z))
          (vector-copy! (the-as vector (-> self root quat)) (the-as vector (-> s quat)))
          ;; A ghost must never retain an animation supplied by a mission, task,
          ;; dark/light-Jak transformation, or replay art-group. Those groups are
          ;; streamed and can be recycled while this persistent process exists.
          ;; jakb-walk-ja belongs to the permanent base Jak group, so loop it for
          ;; presentation while replay position and rotation remain exact.
          (when (and (nonzero? (-> self skel))
                     (> (-> self skel active-channels) 0))
            (let ((anim (the-as art-joint-anim jakb-walk-ja)))
              (when (!= (ja-group) anim)
                (ja-channel-set! 1)
                (joint-control-channel-group-eval! (-> self skel root-channel 0) anim num-func-identity))
              (set! (-> self skel root-channel 0 frame-num)
                    (the float
                      (mod i (max 1 (+ (the int (-> anim frames num-frames)) -1)))))))
          ;; Hold only until the live attempt has crossed its initial control
          ;; release. The release flag is one-way for this run, so later mission
          ;; state changes can never pause an already-moving replay.
          (let* ((next-i (if (>= (+ i 1) cnt) 0 (+ i 1)))
                 (next-state (-> self samples next-i state)))
            (when (or (not (-> *ghost-recording* recording?))
                      *ghost-race-released?*
                      (ghost-control-locked-state? next-state))
              (set! (-> self idx) next-i)))))
      (ja-post)
      (suspend)))
  :post
  (behavior ()
    (when (and (-> self runner-on-screen?)
               (nonzero? (-> self runner-name)))
      (print-game-text (-> self runner-name) (-> self runner-font) #f 44
                       (bucket-id debug-no-zbuf1)))))

(defmethod relocate ((this ghost-player) (diff int))
  (when (nonzero? (-> this runner-name))
    (&+! (-> this runner-name) diff))
  (when (nonzero? (-> this runner-font))
    (&+! (-> this runner-font) diff))
  (call-parent-method this diff))

(defbehavior ghost-player-init-by-other ghost-player ((clone-idx int))
  (stack-size-set! (-> self main-thread) 1024)
  (set! (-> self idx) 0)
  (set! (-> self runner-name) (new 'process 'string 2048 (the-as string #f)))
  (clear (-> self runner-name))
  (if (< clone-idx *ghost-replay-count*)
      (pc-replay-get-ready-name clone-idx (-> self runner-name))
      (format (-> self runner-name) "Personal Best"))
  (when (string= (-> self runner-name) "")
    (format (-> self runner-name) "Replay ~D" (+ clone-idx 1)))
  (pc-encode-utf8-string (-> self runner-name) (-> self runner-name))
  (set! (-> self runner-font)
        (new 'process 'font-context *font-default-matrix* 0 0 0.0
             (font-color font-color-32)
             (font-flags shadow kerning large middle)))
  (set-scale! (-> self runner-font) 0.35)
  (set-width! (-> self runner-font) 220)
  (set-height! (-> self runner-font) 30)
  (cond
    ((< clone-idx *ghost-replay-count*)
     ;; The imported JSON copies already contain their spatial offsets.
     (let ((replay (-> *ghost-replays* clone-idx)))
       (set! (-> self samples) (-> replay samples))
       (set! (-> self frames) (-> replay count)))
     (vector-zero! (-> self offset)))
    (else
     ;; Fallback for a freshly recorded in-memory replay without a JSON pack.
     (set! (-> self samples) (-> *ghost-recording* play-samples))
     (set! (-> self frames) (-> *ghost-recording* play-count))
     (set-vector!
       (-> self offset)
       (* (the float (- (mod clone-idx 11) 5)) *ghost-playback-spacing*)
       0.0
       (* (the float (- (/ clone-idx 11) 1)) *ghost-playback-spacing*)
       0.0)))
  ;; If the server finished downloading after the run began, jump to the
  ;; corresponding recorded frame instead of starting the opponent late.
  (when (and (-> *ghost-recording* recording?)
             (> (-> self frames) 0))
    (set! (-> self idx)
          (min (-> *ghost-recording* rec-count) (- (-> self frames) 1)))
    ;; A late download may initially synchronize beyond the replay's release
    ;; frame while the live attempt is still locked. Rewind to the replay's
    ;; final locked frame; the one-way release latch resumes it exactly once.
    (when (and (not *ghost-race-released?*)
               (not (ghost-control-locked-state?
                      (-> self samples (-> self idx) state))))
      (let ((release-idx 0))
        (while (and (< release-idx (-> self frames))
                    (ghost-control-locked-state?
                      (-> self samples release-idx state)))
          (+! release-idx 1))
        (set! (-> self idx) (max 0 (- release-idx 1))))))
  (set! (-> self root) (new 'process 'trsqv))
  ;; a fresh trsqv has scale 0 - without this the whole model collapses to a point!
  (vector-identity! (-> self root scale))
  (quaternion-identity! (-> self root quat))
  ;; Use the same physical-level + selected-skeleton pairing as normal gameplay.
  ;; skeleton-group->draw-control understands this level's master-level fallback;
  ;; binding directly to the master breaks missions whose selected Jak art lives
  ;; in the physical level's art group.
  (set! (-> self level) (level-get-target-inside *level*))
  ;; Start at frame zero, or at the synchronized frame for a late download.
  (when (> (-> self frames) 0)
    (let ((s (-> self samples (-> self idx))))
      (vector-copy! (-> self root trans) (-> s pos))
      (+! (-> self root trans x) (-> self offset x))
      (+! (-> self root trans z) (-> self offset z))
      (vector-copy! (the-as vector (-> self root quat)) (the-as vector (-> s quat)))))
  ;; Match the geometry currently selected for the real target.  "skel-jchar"
  ;; is only the bootstrap geometry; normal gameplay swaps it to the Jak 2,
  ;; classic, or Jak 3 body selected by target-skel-group.
  (initialize-skeleton self (target-skel-group) (the-as pair 0))
  ;; Replace the initializer's channel immediately, before this process can be
  ;; drawn. The base walk animation is permanent; a current target animation may
  ;; come from a task/transformation DGO that can unload during this attempt.
  (when (and (nonzero? (-> self skel))
             (> (-> self skel active-channels) 0))
    (ja-channel-set! 1)
    (joint-control-channel-group-eval!
      (-> self skel root-channel 0)
      (the-as art-joint-anim jakb-walk-ja)
      num-func-identity))
  ;; The cloth engine has only 32 slots. Keep the Jak 3 body mesh, but do not
  ;; submit cloth simulations for 33 ghosts plus the real player.
  (set! (-> self draw cloth-instances) (the-as (array cloth-system) #f))
  ;; Shadow2 has one fixed-size vertex buffer for all foreground actors.  The
  ;; projected shadows from 33 full Jak skeletons overflow it, so replay ghosts
  ;; do not submit shadows.  Do not edit the shared target shadow-control object:
  ;; the real player's shadow should remain enabled.
  (set! (-> self draw shadow-ctrl) #f)
  (set! (-> self draw shadow) #f)
  ;; wire the root cspace (bone 0) to follow our root trsqv's full transform
  ;; (trans+quat+scale). without this the root bone is garbage and the mesh collapses.
  (let ((nl (-> self node-list data)))
    (set! (-> nl 0 param0) (the-as (function cspace transformq none) cspace<-transformq+trans!))
    (set! (-> nl 0 param1) (the-as basic (-> self root trans)))
    (set! (-> nl 0 param2) (the-as basic *null-vector*)))
  ;; pose the skeleton every frame + light it like a normal actor
  (logior! (-> self skel status) (joint-control-status sync-math))
  (set! (-> self draw light-index) (the-as uint 30))
  (set! (-> self draw lod-set max-lod) 0)
  ;; ghost look: blue tint (translucency via force-fade can be re-enabled once visible)
  (set-vector! (the-as vector (-> self draw color-mult)) 0.4 0.7 1.0 1.0)
  (go-virtual idle))

(defun ghost-stop-playback ()
  "Remove every active ghost clone. The pinned replay data is retained."
  (kill-by-type ghost-player *pc-pool*)
  (none))

(defun ghost-free-process-count ()
  "Count the reusable ghost processes currently back in the fixed dead pool."
  (let ((node (-> *ghost-dead-pool* child))
        (count 0))
    (while node
      (+! count 1)
      (set! node (-> node 0 brother)))
    count))

(defun ghost-memory-stress-test! ((cycles int))
  "Repeatedly reload, spawn, render, and kill the selected ghost pack.
   A warmup reaches all lazy high-water marks before measured cycles verify
   that replay data, the global heap, and the fixed process pool stay stable."
  (kill-by-name "ghost-memory-stress-test" *pc-pool*)
  (process-spawn-function process
    :name "ghost-memory-stress-test"
    :to *pc-pool*
    :stack-size #x10000
    (lambda :behavior process ((cycles int))
      (stack-size-set! (-> self main-thread) 2048)
      (cond
        ((or (not *target*) (= (-> *speedrun-info* category) (the-as speedrun-category -1)))
         (format 0 "ghost-memory-test: ERROR no active mission/player~%"))
        (else
         (let ((category (-> *speedrun-info* category))
               (baseline-global 0)
               (baseline-replay 0)
               (max-global-growth 0)
               (saved-recording? (-> *ghost-recording* recording?))
               (saved-rec-count (-> *ghost-recording* rec-count))
               (failed? #f))
           (format 0 "ghost-memory-test: START warmup=24 cycles=~D~%" cycles)
           ;; Several engine/render caches are populated lazily. Warm through
           ;; those bounded high-water allocations before measuring retention.
           (dotimes (warmup 24)
             (ghost-load-local-stress-pack! category)
             (ghost-spawn-playback!)
             (dotimes (frame 3) (suspend))
             (ghost-stop-playback)
             (dotimes (frame 2) (suspend)))
           (when (= *ghost-replay-count* 0)
             (format 0 "ghost-memory-test: ERROR no downloaded replay files~%"))
           (set! baseline-global
                 (&- (-> global current) (the-as uint (-> global base))))
           (set! baseline-replay
                 (&- (-> *ghost-replay-heap* current)
                     (the-as uint (-> *ghost-replay-heap* base))))
           (dotimes (cycle cycles)
             ;; Force the same path used after a server selection refresh.
             (ghost-load-local-stress-pack! category)
             (ghost-spawn-playback!)
             (dotimes (frame 3) (suspend))
             (ghost-stop-playback)
             (dotimes (frame 2) (suspend))
             (let ((global-used
                     (&- (-> global current) (the-as uint (-> global base))))
                   (replay-used
                     (&- (-> *ghost-replay-heap* current)
                         (the-as uint (-> *ghost-replay-heap* base)))))
               (set! max-global-growth
                     (max max-global-growth (- global-used baseline-global)))
               (when (!= replay-used baseline-replay)
                 (set! failed? #t))
               (when (or (= cycle 0)
                         (= (mod (+ cycle 1) 10) 0)
                         (= (+ cycle 1) cycles))
                 (format 0 "ghost-memory-test: cycle=~D global=~D replay=~D growth=~D~%"
                         (+ cycle 1)
                         global-used
                         replay-used
                         (- global-used baseline-global)))))
           (when (!= (ghost-free-process-count) GHOST_MAX_PLAYERS)
             (set! failed? #t)
             (format 0 "ghost-memory-test: process leak; free=~D expected=~D~%"
                     (ghost-free-process-count)
                     GHOST_MAX_PLAYERS))
           ;; Exercise the real crash sequence: a non-PB finish must return all
           ;; persistent ghost players before the mission unloads its art, and a
           ;; reset of the following attempt must do the same.
           (ghost-load-local-stress-pack! category)
           (ghost-spawn-playback!)
           (dotimes (frame 3) (suspend))
           (set! (-> *ghost-recording* recording?) #t)
           (set! (-> *ghost-recording* rec-count) 0)
           (ghost-stop-recording! 0.0 #f)
           (dotimes (frame 2) (suspend))
           (when (!= (ghost-free-process-count) GHOST_MAX_PLAYERS)
             (set! failed? #t)
             (format 0 "ghost-memory-test: finish cleanup failed; free=~D~%"
                     (ghost-free-process-count)))
           (ghost-load-local-stress-pack! category)
           (ghost-spawn-playback!)
           (dotimes (frame 3) (suspend))
           (set! (-> *ghost-recording* recording?) #t)
           (set! (-> *ghost-recording* rec-count) 0)
           (ghost-discard-recording!)
           (dotimes (frame 2) (suspend))
           (when (!= (ghost-free-process-count) GHOST_MAX_PLAYERS)
             (set! failed? #t)
             (format 0 "ghost-memory-test: retry cleanup failed; free=~D~%"
                     (ghost-free-process-count)))
           (set! (-> *ghost-recording* recording?) saved-recording?)
           (set! (-> *ghost-recording* rec-count) saved-rec-count)
           (cond
             ((or failed? (> max-global-growth #x1000))
              (format 0 "ghost-memory-test: FAIL global-growth=~D replay-baseline=~D~%"
                      max-global-growth
                      baseline-replay))
             (else
               (format 0 "ghost-memory-test: PASS global-growth=~D replay-bytes=~D~%"
                      max-global-growth
                      baseline-replay)))))))
    cycles)
  (none))

(defun ghost-spawn-playback! ()
  "Restart the playback pack from frame zero."
  (ghost-stop-playback)
  ;; Automatic playback must not build skeletons on the same frame the mission
  ;; releases Jak. Task DGOs can still be retiring at that point.
  (cond
    ((and (-> *ghost-recording* recording?)
          (not *ghost-race-released?*))
     (format 0 "ghost: blocked playback before mission release~%"))
    (else
     (let ((available (if (> *ghost-replay-count* 0)
                           *ghost-replay-count*
                           (if (-> *ghost-recording* have-ghost?) 1 0)))
           (want 0)
           (spawned 0)
           (playback-level (level-get-target-inside *level*)))
       (cond
         ((not playback-level)
          (format 0 "ghost: ERROR no target level for playback~%"))
         (else
          (set! want (max 1 (min available (min GHOST_MAX_PLAYERS *ghost-playback-count*))))
          (dotimes (i want)
            ;; process-spawn schedules the init behavior; the returned process has
            ;; not necessarily populated its level field yet.
            (when (process-spawn ghost-player i :from *ghost-dead-pool* :to *pc-pool*)
              (+! spawned 1)))
          (format 0 "ghost: spawned ~D/~D independent replay players~%" spawned want))))))
  (none))

(defun ghost-await-safe-spawn! ((category speedrun-category))
  "Spawn after control release and a short scheduler/DGO settling window."
  (kill-by-name "ghost-safe-spawn-wait" *pc-pool*)
  (process-spawn-function process :name "ghost-safe-spawn-wait" :to *pc-pool*
    (lambda :behavior process ((category speedrun-category))
      (stack-size-set! (-> self main-thread) 1024)
      (while (and (-> *ghost-recording* recording?)
                  (= (-> *speedrun-info* category) category)
                  (not *ghost-race-released?*))
        (suspend))
      (when (and (-> *ghost-recording* recording?)
                 (= (-> *speedrun-info* category) category)
                 *target*)
        ;; Run start and DGO retirement happen on different scheduler passes.
        ;; Playback synchronizes to rec-count, so this does not make ghosts late.
        (dotimes (frame 3) (suspend))
        (when (and (-> *ghost-recording* recording?)
                   (= (-> *speedrun-info* category) category)
                   *target*)
          (ghost-spawn-playback!))))
    category)
  (none))

(defun ghost-await-server-pack! ((category speedrun-category))
  "Attach a replay that is still downloading when the IL begins."
  ;; Level/task transitions clear the active pool. Keep the waiter beside the
  ;; replay players in the persistent PC pool so the first attempt still gets
  ;; its pack when the asynchronous download completes during a transition.
  (kill-by-name "ghost-server-wait" *pc-pool*)
  (process-spawn-function process :name "ghost-server-wait" :to *pc-pool*
    (lambda :behavior process ((category speedrun-category))
      (stack-size-set! (-> self main-thread) 1024)
      (let ((generation 0))
        (while (and (= generation 0)
                    (-> *ghost-recording* recording?)
                    (= (-> *speedrun-info* category) category))
          (set! generation
                (pc-replay-prepare-selected
                  (enum->string speedrun-category category)))
          (when (= generation 0)
            (suspend)))
        (when (and (> generation 0)
                   (-> *ghost-recording* recording?)
                   (= (-> *speedrun-info* category) category)
                   (> (pc-replay-selected-count) 0))
          (ghost-load-json-pack! category)
          (when (> *ghost-replay-count* 0)
            (ghost-await-safe-spawn! category)))))
    category)
  (none))

(defun ghost-clear-replay! ()
  "Discard the pinned replay so the next completed run becomes the new replay."
  (ghost-stop-playback)
  (set! (-> *ghost-recording* have-ghost?) #f)
  (set! (-> *ghost-recording* play-count) 0)
  (set! *ghost-replay-count* 0)
  (set! *ghost-replay-category* (the-as speedrun-category -1))
  (set! *ghost-replay-generation* 0)
  (format 0 "ghost: pinned replay cleared; next completed run will be kept~%")
  (none))

(defun ghost-play ()
  "Spawn the offset pack that replays the pinned IL recording."
  (when *target*
    (ghost-load-json-pack! (-> *speedrun-info* category)))
  (cond
    ((and (= *ghost-replay-count* 0)
          (not (-> *ghost-recording* have-ghost?)))
     (format 0 "ghost: no completed recording to play~%"))
    ((not *target*)
     (format 0 "ghost: no player loaded~%"))
    (else
     (ghost-spawn-playback!)))
  (none))

(defun ghost-on-run-start! ()
  "Called when an IL run begins: resolve the selected replay mode, then start
   recording the new attempt."
  ;; Start counting immediately so a server replay that finishes downloading a
  ;; few frames later can begin at the matching point in the current attempt.
  (ghost-start-recording!)
  (when *target*
    (let ((category (-> *speedrun-info* category)))
      (ghost-load-json-pack! category)
      (cond
        ((> *ghost-replay-count* 0)
         (ghost-await-safe-spawn! category))
        ;; A server pack can still be pending when the mission starts. Falling
        ;; back to the local PB here made every mode look like Personal Best on
        ;; slower connections. Only that explicit mode may use the local copy;
        ;; every other mode waits for its resolved pack (or correctly uses none).
        ((and (pc-replay-personal-best-mode-selected)
              (-> *ghost-recording* have-ghost?)
              (= (-> *ghost-recording* category) category))
         (ghost-await-safe-spawn! category))
        (else
         (ghost-await-server-pack! category)))))
  (none))
