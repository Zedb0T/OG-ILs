;; Opt-in dedicated-profile integration test. Never enable in normal gameplay.
(in-package goal)
(define-extern *game-options-pc* menu-option-list)

(defun replay-service-test-run! ()
  (set! *replay-ghost-stress-active?* #t)
  (process-spawn-function process :name "replay-service-test" :to *pc-pool* :stack-size #x10000
    (lambda :behavior process ()
      (stack-size-set! (-> self main-thread) 2048)
      (until (or *scene-player* *target*) (suspend))
      (when *scene-player* (send-event (ppointer->process *scene-player*) 'abort))
      (dotimes (i 180) (suspend))
      (set-category! *speedrun-info* (speedrun-category desert-bbush-get-to-19))
      (start-run! *speedrun-info*)
      (until (and (-> *speedrun-info* has-started?) *target* (= *master-mode* 'game)) (suspend))
      (let ((manager (the-as task-manager (process-by-name "wascity-bbush-get-to-19-resolution" *active-pool*))))
        (when manager (set! (-> manager time-limit) (seconds 600))))
      (let ((failed? #f)
            (category "desert-bbush-get-to-19")
            (label (new 'process 'string 256 (the-as string #f))))
        (pc-replay-client-command 6 0 category)
        (dotimes (i 300) (suspend))
        (pc-replay-client-text 0 0 label)
        (format 0 "GHOST-SERVICE: upload=~S~%" label)
        (when (not (string= label "Submitted replay")) (set! failed? #t))
        (dotimes (test 5)
          (let ((mode (case test ((0) 1) ((1) 3) ((2) 0) ((3) 2) (else 4)))
                (expected (case test ((0) 1607) ((1) 400) ((2) 1200) (else 600))))
            (replay-ghost-stop!)
            (pc-replay-client-command 1 mode category)
            (when (= mode 4)
              (pc-replay-client-command 15 0 category)
              (dotimes (i 180) (suspend))
              (pc-replay-client-command 5 0 category)
              (pc-replay-client-command 5 1 category))
            (let ((deadline (+ (get-current-time) (seconds 20))) (frames 0))
              (while (and (= frames 0) (< (get-current-time) deadline))
                (set! frames (pc-replay-playback-start category))
                (suspend))
              (pc-replay-client-text 2 0 label)
              (format 0 "GHOST-SERVICE: mode=~D frames=~D label=~S files=~D~%"
                      mode frames label (pc-replay-client-command 12 0 category))
              (when (!= frames expected) (set! failed? #t))
              (when (= mode 4)
                (when (or (!= (pc-replay-client-command 12 0 category) 2)
                          (!= (pc-replay-client-command 13 1 category) 1200))
                  (set! failed? #t))))
            (replay-ghost-spawn-now! (speedrun-category desert-bbush-get-to-19) 0)
            (dotimes (i 350) (suspend))
            (when (!= *replay-ghost-spawned-count* (if (= mode 4) 2 1)) (set! failed? #t))
            (dotimes (slot *replay-ghost-spawned-count*)
              (let ((ghost (the-as replay-ghost-player (replay-ghost-resolve (-> *replay-ghost-slots* players slot)))))
                (when (or (not ghost) (< (-> ghost idx) 349) (not (-> ghost sample-valid?))
                          (not (-> ghost extra-valid?)) (not (replay-ghost-resolve (-> ghost extra-handle))))
                  (set! failed? #t))))
            (when *replay-ghost-failure?* (set! failed? #t))
            (format 0 "GHOST-SERVICE: rendered mode=~D count=~D failed=~S~%" mode *replay-ghost-spawned-count* failed?)))
        (replay-ghost-stop!)
        (format 0 "GHOST-SERVICE: RESULT ~S~%" (if failed? "FAIL" "PASS"))
        ;; Open the actual native progress page for screenshot inspection.
        (activate-progress *target* 'options)
        (when *progress-process*
          (let* ((page (the-as menu-generic-scrolling-page (-> *game-options-pc* options 0)))
                 (link (the-as menu-generic-link-option (-> page menu-options 0))))
            (navigate! *progress-pc-generic-store* (-> *progress-process* 0) (-> link target) (the-as (function none) #f)))))))
  (none))

;; Dedicated isolated-profile entry point; never run automatically.
;; (replay-service-test-run!)
