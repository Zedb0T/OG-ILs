(defun maybe-update-best-time ((this speedrun-timer))
  (when (not (or *debug-segment* *cheat-mode*))
    (let ((pb-time (get-pb-time)))
      (when (or (= pb-time 0.0) (< (-> this recorded-time) pb-time))
        (case (-> *speedrun-info* category)
          ;; Act 1
          (((speedrun-category arena-training-1))
            (set! (-> *pc-settings* pb-time-arena-training-1) (-> this recorded-time)))
          (((speedrun-category arena-fight-1))
            (set! (-> *pc-settings* pb-time-arena-fight-1) (-> this recorded-time)))
          (((speedrun-category wascity-chase))
            (set! (-> *pc-settings* pb-time-wascity-chase) (-> this recorded-time)))
          (((speedrun-category wascity-pre-game))
            (set! (-> *pc-settings* pb-time-wascity-pre-game) (-> this recorded-time)))
          (((speedrun-category desert-turtle-training))
            (set! (-> *pc-settings* pb-time-desert-turtle-training) (-> this recorded-time)))
          (((speedrun-category desert-course-race))
            (set! (-> *pc-settings* pb-time-desert-course-race) (-> this recorded-time)))
          (((speedrun-category desert-artifact-race-1))
            (set! (-> *pc-settings* pb-time-desert-artifact-race-1) (-> this recorded-time)))
          (((speedrun-category wascity-leaper-race))
            (set! (-> *pc-settings* pb-time-wascity-leaper-race) (-> this recorded-time)))
          (((speedrun-category desert-hover))
            (set! (-> *pc-settings* pb-time-desert-hover) (-> this recorded-time)))
          (((speedrun-category arena-fight-2))
            (set! (-> *pc-settings* pb-time-arena-fight-2) (-> this recorded-time)))
          (((speedrun-category desert-catch-lizards))
            (set! (-> *pc-settings* pb-time-desert-catch-lizards) (-> this recorded-time)))
          (((speedrun-category desert-rescue))
            (set! (-> *pc-settings* pb-time-desert-rescue) (-> this recorded-time)))
          (((speedrun-category wascity-gungame))
            (set! (-> *pc-settings* pb-time-wascity-gungame) (-> this recorded-time)))
          (((speedrun-category arena-fight-3))
            (set! (-> *pc-settings* pb-time-arena-fight-3) (-> this recorded-time)))
