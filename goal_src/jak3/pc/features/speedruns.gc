(define-extern reset-arena-trainer-globals (function none))
(defmethod start-run! ((this speedrun-info))
  ;; A reset/retry closes the previous unfinished attempt before streaming.
  (replay-record-stop! #f)
  ;; turn on speedrun verification display
  (true! (-> this display-run-info?))
  ;; reset has-started? flag so we can flip it back to #t when jak touches ground/out of blackout
  (false! (-> *speedrun-info* has-started?))
  (send-event (ppointer->process *speedrun-manager*) 'start-run)
  ;; try to load times from SRC
  (pc-fetch-external-mission-times 
    (enum->string speedrun-category (-> *speedrun-info* category)) 
    0)
  ;; ensure any required settings are enabled
  (enforce-settings! this)
  ;; reset end-task
  (set! (-> this active-practice-objective end-task) (game-task none))
  ;; reset wpg stats
  (set! (-> this wpg hits) 0)
  (set! (-> this wpg misses) 0)
  (set! (-> this wpg doubles) 0)
  (set! (-> this wpg triples) 0)
  (set! (-> this wpg pairs) 0)
  ;; make sure silly arena-trainer globals are reset if we're resetting from arena
  (when (process-by-name "arena-training-1-collect" *entity-pool*)
    (reset-arena-trainer-globals))
  ;; finalize any category specific setup code
  (case (-> this category)
    (((speedrun-category newgame-normal))
     (set! (-> *game-info* mode) 'debug)
     (initialize! *game-info* 'game (the game-save #f) (the string #f) (the resetter-spec #f))
     (set! (-> *game-info* mode) 'play)
     (start 'play (get-continue-by-name *game-info* "wasstada-jump-training"))
     (play-task (game-task arena-training-1) 'debug #f))
    (((speedrun-category newgame-heromode))
     (process-spawn-function process
       (lambda :behavior process ()
         (set! (-> *game-info* mode) 'debug)
         (initialize! *game-info* 'game (the game-save #f) (the string #f) (the resetter-spec #f))
         (set! (-> *game-info* mode) 'play)
         (logior! (-> *game-info* secrets) (game-secrets hero-mode))
         (logior! (-> *game-info* purchase-secrets) (game-secrets hero-mode))
         (start 'play (get-continue-by-name *game-info* "wasstada-jump-training"))
         (play-task (game-task arena-training-1) 'debug #f)
         (until (and *target* (!= (-> *target* next-state name) 'target-continue))
           (suspend))
         (send-event *target* 'get-pickup (pickup-type gem) 1000.0)
         (set! (-> *game-info* secrets) HERO_MODE_SECRETS)
         (set! (-> *game-info* purchase-secrets) HERO_MODE_SECRETS)
         (set! (-> *game-info* features) HERO_MODE_FEATURES))))
    (((speedrun-category all-cheats-allowed))
     (process-spawn-function process
       (lambda :behavior process ()
         (set! (-> *game-info* mode) 'debug)
         (initialize! *game-info* 'game (the game-save #f) (the string #f) (the resetter-spec #f))
         (set! (-> *game-info* mode) 'play)
         (start 'play (get-continue-by-name *game-info* "wasstada-jump-training"))
         (play-task (game-task arena-training-1) 'debug #f))))
    ;; Act 1 ILs
    (((speedrun-category arena-training-1))
      (start-individual-level-run! this (game-task arena-training-1) #f (game-secrets)))
    (((speedrun-category arena-fight-1))
      (start-individual-level-run! this (game-task arena-fight-1) #f (game-secrets)))
    (((speedrun-category wascity-chase))
      (start-individual-level-run! this (game-task wascity-chase) #f (game-secrets)))
    (((speedrun-category wascity-pre-game))
      (start-individual-level-run! this (game-task wascity-pre-game) #f (game-secrets)))
    (((speedrun-category desert-turtle-training))
      (start-individual-level-run! this (game-task desert-turtle-training) #f (game-secrets)))
    (((speedrun-category desert-course-race))
      (start-individual-level-run! this (game-task desert-course-race) #f (game-secrets)))
    (((speedrun-category desert-artifact-race-1))
      (start-individual-level-run! this (game-task desert-artifact-race-1) #f (game-secrets)))
    (((speedrun-category wascity-leaper-race))
      (start-individual-level-run! this (game-task wascity-leaper-race) #f (game-secrets)))
    (((speedrun-category desert-hover))
      (start-individual-level-run! this (game-task desert-hover) #f (game-secrets)))
    (((speedrun-category arena-fight-2))
      (start-individual-level-run! this (game-task arena-fight-2) #f (game-secrets)))
    (((speedrun-category desert-catch-lizards))
      (start-individual-level-run! this (game-task desert-catch-lizards) #f (game-secrets)))
    (((speedrun-category desert-rescue))
      (start-individual-level-run! this (game-task desert-rescue) #f (game-secrets)))
    (((speedrun-category wascity-gungame))
      (start-individual-level-run! this (game-task wascity-gungame) #f (game-secrets)))
    (((speedrun-category arena-fight-3))
      (start-individual-level-run! this (game-task arena-fight-3) #f (game-secrets)))
    (((speedrun-category nest-eggs))
      (start-individual-level-run! this (game-task nest-eggs) #f (game-secrets)))
    (((speedrun-category temple-climb))
      (start-individual-level-run! this (game-task temple-climb) #f (game-secrets)))
    (((speedrun-category desert-glide))
      (start-individual-level-run! this (game-task desert-glide) #f (game-secrets)))
