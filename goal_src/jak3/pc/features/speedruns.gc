(defun get-override-vehicle-name ()
  (let ((v (if (nonzero? (-> *speedrun-info* override-vehicle)) (-> *speedrun-info* override-vehicle) (-> *game-info* current-vehicle))))
    (case v
      (((vehicle-type vt27)) "On Foot")
      (((vehicle-type v-turtle)) "Tough Puppy")
      (((vehicle-type v-snake)) "Sand Shark")
      (((vehicle-type v-toad)) "Dune Hopper")
      (((vehicle-type v-scorpion)) "Gila Stomper")
      (((vehicle-type v-rhino)) "Slam Dozer")
      (((vehicle-type v-fox)) "Heat Seeker")
      (((vehicle-type v-mirage)) "Dust Demon")
      (((vehicle-type v-x-ride)) "Desert Screamer")
      (((vehicle-type v-marauder)) "Marauder")
      (((vehicle-type v-faccar)) "Factory Car")
      (else "N/A")
      )
    )
  )

(defun get-override-vehicle ()
  (-> *speedrun-info* override-vehicle))

(defun print-speedrun-end-results-text ((buf dma-buffer) (alpha float))
  (let* ((pb-time (get-pb-time))
         (pb-total-sec (the int pb-time))
         (lines-used 0)
         (pb-min (/ pb-total-sec 60))
         (pb-sec (- pb-total-sec (* pb-min 60)))
         (timer (the-as speedrun-timer (ppointer->process (-> *speedrun-manager* 0 timer))))
         (cur-total-sec (the int (-> timer recorded-time)))
         (cur-min (/ cur-total-sec 60))
         (cur-sec (- cur-total-sec (* cur-min 60)))
         (font-ctx (new 'stack 'font-context *font-default-matrix* 256 84 0.0 (font-color default) (font-flags middle shadow kerning large)))
         )
    ;; (try to) fetch WR
    (clear *pc-cpp-temp-string*)
    (set! (-> *progress-pc-generic-store* custom-highscore-score) -1.0)
    (if (= (-> *speedrun-info* percent-warped?) 'major)
      (pc-get-external-warp-mission-time 
        (enum->string speedrun-category (-> *speedrun-info* category))
        0 *pc-cpp-temp-string* (&-> *progress-pc-generic-store* custom-highscore-score))
      (pc-get-external-any-mission-time 
        (enum->string speedrun-category (-> *speedrun-info* category))
        0 *pc-cpp-temp-string* (&-> *progress-pc-generic-store* custom-highscore-score))
      )

    ;; print mission header
    (clear *temp-string*)
    (clear *pc-encoded-temp-string*)
    (cond
      ((-> *speedrun-category-names-2* (-> *speedrun-info* category))
        ;; need an extra line
        (+! lines-used 3)
        (format *temp-string* "~4L~S~%~S~%" (-> *speedrun-category-names* (-> *speedrun-info* category)) (-> *speedrun-category-names-2* (-> *speedrun-info* category))))
      (else
        (+! lines-used 2)
        (format *temp-string* "~4L~S~%" (-> *speedrun-category-names* (-> *speedrun-info* category))))
      )
    (format *temp-string* "~6LMission Completed~%")
    (+! lines-used 1)
    (case (-> *speedrun-info* percent-warped?)
      (('minor)
        (format *temp-string* "~0LMinor Percentage Warp Used~%")
        (+! lines-used 1))
      (('major)
        (format *temp-string* "~3LMajor Percentage Warp Used!~%")
        (+! lines-used 1))
      )
    (set! (-> font-ctx alpha) alpha)
    (set! (-> font-ctx scale) 0.5)
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (draw-string-adv *pc-encoded-temp-string* buf font-ctx)

    ;; print time
    (clear *temp-string*)
    (clear *pc-encoded-temp-string*)
    (format *temp-string* "~32LMission Time: ~0L~D:~2,'0D~%" cur-min cur-sec)
    (cond
      ;; NEW PB!
      ((= pb-time (-> timer recorded-time))
        (format *temp-string* "~14LNEW PERSONAL BEST!~0L~%~%")
        )
      ;; not a PB
      (else
        (format *temp-string* "~32LPersonal Best: ~0L~D:~2,'0D~%~%" pb-min pb-sec)
        )
      )
    (+! lines-used 3)
    (set-origin! font-ctx 256 (+ 84 (* (- lines-used 3) 15)))
    (set! (-> font-ctx alpha) alpha)
    (set! (-> font-ctx scale) 0.5)
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
    
    ;; print WR stuff
    (when (> (-> *progress-pc-generic-store* custom-highscore-score) 0)
      (let* ((wr-total-sec (the int (-> *progress-pc-generic-store* custom-highscore-score)))
             (wr-min (/ wr-total-sec 60))
             (wr-sec (- wr-total-sec (* wr-min 60)))
             (tmp-lines 2))
        (clear *temp-string*)
        (clear *pc-encoded-temp-string*)
        (format *temp-string* "~32LWorld Record: ~0L~D:~2,'0D (~S)~%" wr-min wr-sec *pc-cpp-temp-string*)
        (cond
          ((< (max cur-total-sec 1) wr-total-sec)
            (format *temp-string* "~14LUNTIED WORLD RECORD!~0L~%~%")
            (+! tmp-lines 1)
            )
          ((= (max cur-total-sec 1) wr-total-sec)
            (format *temp-string* "~14LTIED WORLD RECORD!~0L~%~%")
            (+! tmp-lines 1)
            )
          )
        (+! lines-used tmp-lines)
        (set-origin! font-ctx 256 (+ 84 (* (- lines-used tmp-lines) 15)))
        (set! (-> font-ctx alpha) alpha)
        (set! (-> font-ctx scale) 0.5)
        (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
        (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
        )
      )

    ;; print vehicle, for wasteland side missions
    (clear *temp-string*)
    (clear *pc-encoded-temp-string*)
    (case (-> *speedrun-info* category)
      (((speedrun-category desert-bbush-get-to-1) (speedrun-category desert-bbush-get-to-2) (speedrun-category desert-bbush-get-to-3) (speedrun-category desert-bbush-get-to-4)
        (speedrun-category desert-bbush-get-to-5) (speedrun-category desert-bbush-get-to-6) (speedrun-category desert-bbush-get-to-7) (speedrun-category desert-bbush-get-to-8)
        (speedrun-category desert-bbush-get-to-9) (speedrun-category desert-bbush-get-to-11) (speedrun-category desert-bbush-get-to-12) (speedrun-category desert-bbush-get-to-14)
        (speedrun-category desert-bbush-get-to-16) (speedrun-category desert-bbush-get-to-17) (speedrun-category desert-bbush-ring-1) (speedrun-category desert-bbush-ring-2)
        (speedrun-category desert-bbush-egg-spider-1) (speedrun-category desert-bbush-spirit-chase-1) (speedrun-category desert-bbush-timer-chase-1)
        (speedrun-category desert-bbush-time-trial-1) (speedrun-category desert-bbush-rally) (speedrun-category desert-rescue-bbush) (speedrun-category desert-bbush-air-time)
        (speedrun-category desert-bbush-total-air-time) (speedrun-category desert-bbush-jump-distance) (speedrun-category desert-bbush-total-jump-distance)
        (speedrun-category desert-bbush-roll-count) (speedrun-category desert-bbush-destroy-interceptors) (speedrun-category wascity-pre-game-2))
        (format *temp-string* "~32LWasteland Vehicle: ~0L~S~%" (get-override-vehicle-name))
        )
      )
    
    ;; print stats
    (format *temp-string* "~32LAverage Speed: ~0L~,,1fm/s~%~%" (/ (-> *speedrun-info* avg-speed) 4096.0))
    ;; TODO - kill stats
    ;; satellite stats
    (when (or (= (-> *speedrun-info* category) (speedrun-category wascity-pre-game))
              (= (-> *speedrun-info* category) (speedrun-category wascity-pre-game-2)))
      (format *temp-string* "~6LHits: ~0L~D~%" (-> *speedrun-info* wpg hits))
      (when (> (-> *speedrun-info* wpg misses) 0)
        (format *temp-string* "~3LMisses: ~0L~D~%" (-> *speedrun-info* wpg misses)))
      (format *temp-string* "~%~32LDoubles: ~0L~D~%" (-> *speedrun-info* wpg doubles))
      (when (> (-> *speedrun-info* wpg triples) 0)
        (format *temp-string* "~4LTriples: ~0L~D~%" (-> *speedrun-info* wpg triples)))
      (when (= (-> *speedrun-info* category) (speedrun-category wascity-pre-game))
        (format *temp-string* "~%~32LPairs: ~0L~D~%" (-> *speedrun-info* wpg pairs)))
      )
    (set-origin! font-ctx 256 (+ 84 (* lines-used 15)))
    (set! (-> font-ctx alpha) alpha)
    (set! (-> font-ctx scale) 0.35)
    (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
    (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
    )
  (none)
  )  

;; (defun play-music ((music-name symbol) (flava uint) (mode uint))
(defun play-music ((music-name symbol) (mode uint))
  ;; (set! (-> *progress-state-pc* music-player-track) info)
  (set-setting! 'music music-name 0.0 0)
  ;; (set-setting! 'sound-flava #f 999999.0 flava)
  (set-setting! 'sound-mode #f 0.0 mode)
  ;; (sound-group-continue (the-as sound-group #xffffffff))
  (apply-settings *setting-control*)
  (sound-group-continue (sound-group music dialog dialog2))
  (none)
  )

(defun fmt-timer-string (out (total-sec float) (wr-x? symbol))
  (let* ((minutes (/ (the int total-sec) 60))
         (sec (- total-sec (* minutes 60))))
    (if wr-x?
      (if (> minutes 0)
        (if (>= sec 10) ;; too lazy to figure out zero padding for floats
          (format out "~D:~,,0f.x~%" minutes sec) ;; MM:SS.x
          (format out "~D:0~,,0f.x~%" minutes sec) ;; MM:0S.x
          )
        (format out "~,,0f.xs~%" total-sec) ;; (S)S.xs
        )
      (if (> minutes 0)
        (if (>= sec 10) ;; too lazy to figure out zero padding for floats
          (format out "~D:~,,2f~%" minutes sec) ;; MM:SS.ms
          (format out "~D:0~,,2f~%" minutes sec) ;; MM:0S.ms
          )
        (format out "~,,2fs~%" total-sec) ;; SS.ms
        )
      )
    )
  )

(defmethod draw-timer ((this speedrun-timer))
  ;; (try to) fetch WR
  (clear *pc-cpp-temp-string*)
  (set! (-> *progress-pc-generic-store* custom-highscore-score) -1.0)
  (pc-get-external-any-mission-time 
        (enum->string speedrun-category (-> *speedrun-info* category))
        0 *pc-cpp-temp-string* (&-> *progress-pc-generic-store* custom-highscore-score))
  ;; print appropriate strings to different sections of the screen
  (let* ((sloc (-> *pc-settings* speedometer))
         (tloc (-> *pc-settings* timer-location))
         (ploc (-> *pc-settings* pb-location))
         (wloc (-> *pc-settings* wr-location))
         (timer-total-sec (cond
                  ((-> this started?) (* (the float (- (get-real-current-time) (-> this start-time))) 0.0033333334))
                  ((-> this stopped?) (-> this recorded-time))
                  (else 0.0)
                  ))
         (pb-total-sec (get-pb-time))
         (wr-total-sec (-> *progress-pc-generic-store* custom-highscore-score))
         )
    ;; (format 0 "category ~D / pb: ~F s / wr: ~F s~%" (-> *speedrun-info* category) pb-total-sec wr-total-sec)
    (dotimes (cur (speedometer-setting max))
      (when (!= cur (speedometer-setting off))
        (clear *temp-string*)
        (clear *pc-encoded-temp-string*)
        (let ((lines 0)
              (x 0)
              (y 0))
          (case cur
            (((speedometer-setting off))) ;; ignore this one
            (((speedometer-setting top-left))
              ;; speedometer
              (when (and *target* (= sloc (speedometer-setting top-left)))
                (format *temp-string* "~,,2f~S~%" (/ (-> *target* control ctrl-xz-vel) 4096.0) (if (= (-> *pc-settings* speedometer-m-s) (speedometer-m-s on)) "m/s" ""))
                (+! lines 1)
                )
              ;; timer
              (when (= tloc (timer-location top-left))
                (fmt-timer-string *temp-string* timer-total-sec #f)
                (+! lines 1)
                )
              ;; pb
              (when (= ploc (pb-wr-location top-left))
                (format *temp-string* "PB: ")
                (if (nonzero? pb-total-sec)
                  (fmt-timer-string *temp-string* pb-total-sec #f)
                  (format *temp-string* "N/A~%"))
                (+! lines 1)
                )
              ;; wr
              (when (= wloc (pb-wr-location top-left))
                (format *temp-string* "WR: ")
                (if (>= wr-total-sec 0.0)
                  (fmt-timer-string *temp-string* wr-total-sec #t) ;; show .XX
                  (format *temp-string* "N/A~%"))
                (+! lines 1)
                )
              ;; we've written everything to temp-string, setup draw coords
              (set! x 2)
              (set! y 2)
              )
            (((speedometer-setting top-right))
              ;; speedometer
              (when (and *target* (= sloc (speedometer-setting top-right)))
                (format *temp-string* "~,,2f~S~%" (/ (-> *target* control ctrl-xz-vel) 4096.0) (if (= (-> *pc-settings* speedometer-m-s) (speedometer-m-s on)) "m/s" ""))
                (+! lines 1)
                )
              ;; timer
              (when (= tloc (timer-location top-right))
                (fmt-timer-string *temp-string* timer-total-sec #f)
                (+! lines 1)
                )
              ;; pb
              (when (= ploc (pb-wr-location top-right))
                (format *temp-string* "PB: ")
                (if (nonzero? pb-total-sec)
                  (fmt-timer-string *temp-string* pb-total-sec #f)
                  (format *temp-string* "N/A~%"))
                (+! lines 1)
                )
              ;; wr
              (when (= wloc (pb-wr-location top-right))
                (format *temp-string* "WR: ")
                (if (>= wr-total-sec 0.0)
                  (fmt-timer-string *temp-string* wr-total-sec #t) ;; show .XX
                  (format *temp-string* "N/A~%"))
                (+! lines 1)
                )
              ;; we've written everything to temp-string, setup draw coords
              (set! x 510)
              (set! y 2)
              )
            (((speedometer-setting center))
              ;; speedometer
              (when (and *target* (= sloc (speedometer-setting center)))
                (format *temp-string* "~,,2f~S~%" (/ (-> *target* control ctrl-xz-vel) 4096.0) (if (= (-> *pc-settings* speedometer-m-s) (speedometer-m-s on)) "m/s" ""))
                (+! lines 1)
                )
              ;; timer
              (when (= tloc (timer-location center))
                (fmt-timer-string *temp-string* timer-total-sec #f)
                (+! lines 1)
                )
              ;; pb
              (when (= ploc (pb-wr-location center))
                (format *temp-string* "PB: ")
                (if (nonzero? pb-total-sec)
                  (fmt-timer-string *temp-string* pb-total-sec #f)
                  (format *temp-string* "N/A~%"))
                (+! lines 1)
                )
              ;; wr
              (when (= wloc (pb-wr-location center))
                (format *temp-string* "WR: ")
                (if (>= wr-total-sec 0.0)
                  (fmt-timer-string *temp-string* wr-total-sec #t) ;; show .XX
                  (format *temp-string* "N/A~%"))
                (+! lines 1)
                )
              ;; we've written everything to temp-string, setup draw coords
              (set! x 256)
              (set! y (- 215 (* lines 5)))
              )
            (((speedometer-setting bottom-left))
              ;; speedometer
              (when (and *target* (= sloc (speedometer-setting bottom-left)))
                (format *temp-string* "~,,2f~S~%" (/ (-> *target* control ctrl-xz-vel) 4096.0) (if (= (-> *pc-settings* speedometer-m-s) (speedometer-m-s on)) "m/s" ""))
                (+! lines 1)
                )
              ;; timer
              (when (= tloc (timer-location bottom-left))
                (fmt-timer-string *temp-string* timer-total-sec #f)
                (+! lines 1)
                )
              ;; pb
              (when (= ploc (pb-wr-location bottom-left))
                (format *temp-string* "PB: ")
                (if (nonzero? pb-total-sec)
                  (fmt-timer-string *temp-string* pb-total-sec #f)
                  (format *temp-string* "N/A~%"))
                (+! lines 1)
                )
              ;; wr
              (when (= wloc (pb-wr-location bottom-left))
                (format *temp-string* "WR: ")
                (if (>= wr-total-sec 0.0)
                  (fmt-timer-string *temp-string* wr-total-sec #t) ;; show .XX
                  (format *temp-string* "N/A~%"))
                (+! lines 1)
                )
              ;; we've written everything to temp-string, setup draw coords
              (set! x 2)
              (set! y (- (if *display-sha* 406 415) (* lines 8)))
              )
            (((speedometer-setting bottom-right))
              ;; speedometer
              (when (and *target* (= sloc (speedometer-setting bottom-right)))
                (format *temp-string* "~,,2f~S~%" (/ (-> *target* control ctrl-xz-vel) 4096.0) (if (= (-> *pc-settings* speedometer-m-s) (speedometer-m-s on)) "m/s" ""))
                (+! lines 1)
                )
              ;; timer
              (when (= tloc (timer-location bottom-right))
                (fmt-timer-string *temp-string* timer-total-sec #f)
                (+! lines 1)
                )
              ;; pb
              (when (= ploc (pb-wr-location bottom-right))
                (format *temp-string* "PB: ")
                (if (nonzero? pb-total-sec)
                  (fmt-timer-string *temp-string* pb-total-sec #f)
                  (format *temp-string* "N/A~%"))
                (+! lines 1)
                )
              ;; wr
              (when (= wloc (pb-wr-location bottom-right))
                (format *temp-string* "WR: ")
                (if (>= wr-total-sec 0.0)
                  (fmt-timer-string *temp-string* wr-total-sec #t) ;; show .XX
                  (format *temp-string* "N/A~%"))
                (+! lines 1)
                )
              ;; we've written everything to temp-string, setup draw coords
              (set! x 510)
              (set! y (- (if (and (-> *pc-settings* speedrunner-mode?) (-> *speedrun-info* display-run-info?)) 396 415) (* lines 8)))
              )
            )
          
          ;; time to draw this bish
          (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
          (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
            ;; reset bucket settings prior to drawing - font won't do this for us, and
            ;; draw-raw-image can sometimes mess them up. (intro sequence)
            (dma-buffer-add-gs-set-flusha buf (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)) (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
            (let* ((font-ctx (new 'stack 'font-context *font-default-matrix* x y 0.0 (font-color default)
                    (case cur
                          (((speedometer-setting top-left) (speedometer-setting bottom-left)) (font-flags shadow kerning large))
                          (((speedometer-setting top-right) (speedometer-setting bottom-right)) (font-flags shadow kerning large right))
                          (((speedometer-setting center)) (font-flags shadow kerning large middle))
                          ))))
              (set! (-> font-ctx scale) 0.25)
              (draw-string-adv *pc-encoded-temp-string* buf font-ctx)))
          )
        )
      )
    )
  (none))

(defun il-speedrun? ()
  (case (-> *speedrun-info* category)
    (((speedrun-category newgame-normal) (speedrun-category newgame-heromode))
      #f
      )
    (else
      #t
      )
    )
  )

(defmethod start! ((this speedrun-timer))
  (true! (-> this started?))
  (false! (-> this stopped?))
  (set! (-> this start-time) (get-real-current-time))
  (set! (-> this end-time) 0)
  ;; This is the canonical IL start edge used by both a menu reset and the
  ;; mission's normal retry flow. Give replay the exact same clock origin.
  (when (il-speedrun?)
    (replay-record-start! (-> this start-time))))

(defmethod reset! ((this speedrun-timer))
  (false! (-> this started?))
  (false! (-> this stopped?))
  (set! (-> this start-time) 0)
  (set! (-> this end-time) 0))

(defmethod stop! ((this speedrun-timer))
  (when (not (-> this stopped?))
    (false! (-> this started?))
    (true! (-> this stopped?))
    (set! (-> this end-time) (get-real-current-time))
    (set! (-> this recorded-time) (* (the float (- (-> this end-time) (-> this start-time))) 0.0033333334))
    (replay-record-stop! #t)
    (maybe-update-best-time this)
    ;; spawn function to bring up end screen whenever we can
    (process-spawn-function process (lambda :behavior process ()
      (until (progress-allowed?)
            (suspend))
        (let ((timer (the-as speedrun-timer (ppointer->process (-> *speedrun-manager* 0 timer))))
              (tmp-music-name (-> *setting-control* user-current music))
              ;; (tmp-flava (-> *setting-control* user-current sound-flava))
              (tmp-mode (-> *setting-control* user-current sound-mode)))
          ;; make sure user didnt manage to reset already
          (when (and timer (-> timer stopped?))
            ;; try to load times from SRC
            (pc-fetch-external-mission-times 
              (enum->string speedrun-category (-> *speedrun-info* category)) 
              (if (= (-> *speedrun-info* percent-warped?) 'major) 1 0))
            (activate-progress *dproc* 'speedrun-end-results)
            (suspend-for (seconds 0.1))
            (play-music 'mcredits (the uint 0))
            ;; (print-stats (-> *statistics* kill-stats) #t)
            (until (progress-allowed?)
              (suspend))
            ;; stop race music, maybe resume old music
            (remove-setting! 'music)
            (apply-settings *setting-control*)
            ;; (sound-group-pause (sound-group music))
            (when tmp-music-name
              (play-music tmp-music-name tmp-mode))
            )
          )
        )
      )
    )
  (-> this recorded-time))

(defun speedrun-saved-category ((value int))
  "Validate persisted built-in selections. Custom runs need additional unsaved state."
  (if (and (>= value (speedrun-category newgame-normal))
           (<= value (speedrun-category palace-ruins-attack-w-bbush)))
      (the-as speedrun-category value)
      (speedrun-category newgame-normal)))

(defmethod set-category! ((this speedrun-info) (category speedrun-category))
  (replay-record-stop! #f)
  (reset! (the-as speedrun-timer (ppointer->process (-> *speedrun-manager* 0 timer))))
  ;; Persist when the user confirms a selection, even before starting/finishing
  ;; an attempt. Avoid rewriting settings when reselecting the same mission.
  (let ((saved (speedrun-saved-category (the-as int category))))
    (when (!= (-> *pc-settings* last-selected-mission) saved)
      (set! (-> *pc-settings* last-selected-mission) (the-as int saved))
      (commit-to-file *pc-settings*)))
  (set! (-> this category) category))

(defmethod start-individual-level-run! ((this speedrun-info) (tsk game-task) (side-mish? symbol) (secrets game-secrets))
  (let ((end-tsk (case tsk
                  (((game-task palace-ruins-patrol-w-bbush))
                    (game-task palace-ruins-patrol))
                  (((game-task palace-ruins-attack-w-bbush))
                    (game-task palace-ruins-attack))
                  (else
                    tsk)
                  )))
    (set! (-> this active-practice-objective end-task) end-tsk)
    ;; remove any camera settings from active run
    (kill-all-persisters *setting-control*)
    (start 'play (get-continue-by-name *game-info* (play-task tsk 'debug 'play)))
    (set-master-mode 'game)
    
    (case tsk
      (((game-task palace-ruins-patrol-w-bbush))
        (task-node-close! (game-task-node palace-ruins-patrol-stadium) 'event))
      (((game-task palace-ruins-attack-w-bbush))
        (task-node-close! (game-task-node palace-ruins-attack-introduction) 'event))
      )
    ;; spawn a process that suspends until jak is properly spawned, before starting timer
    (process-spawn-function process 
      (lambda :behavior process ((side-mish? symbol) (tsk game-task))
        (let ((target-continued? #f))
          (until (and target-continued?
                      (< (-> *game-info* blackout-time) (get-current-time)) 
                      (= (-> *setting-control* user-default bg-a-force) 0.0))
            ;; (if *target* (format 0 "target is in state ~A~%" (-> *target* next-state name)))
            (suspend)
            (when (and *target* (!= (-> *target* next-state name) 'target-continue))
              (true! target-continued?)))
          )
        ;; never ended up using this, we'd need to pass it into the lambda to properly use it
        ;; (logior! (-> *game-info* secrets) secrets)

        (cond
          (side-mish?
            ;; post-game for side missions
            (task-close! "city-win-resolution")
            ;; give most of the standard hero-mode secrets by default
            (logior! (-> *game-info* secrets) (game-secrets endless-ammo
                                                            invulnerable
                                                            endless-dark
                                                            endless-light
                                                            unlimited-turbos
                                                            vehicle-hit-points
                                                            board-fast
                                                            vehicle-fox
                                                            vehicle-mirage
                                                            vehicle-x-ride
                                                            darkjak-tracking
                                                            button-invis
                                                            gun-upgrade-red-1
                                                            gun-upgrade-red-2
                                                            gun-upgrade-red-3
                                                            gun-upgrade-yellow-1
                                                            gun-upgrade-yellow-2
                                                            gun-upgrade-yellow-3
                                                            gun-upgrade-blue-1
                                                            gun-upgrade-blue-2
                                                            gun-upgrade-blue-3
                                                            gun-upgrade-dark-1
                                                            gun-upgrade-dark-2
                                                            gun-upgrade-dark-3
                                                            gun-upgrade-ammo-red
                                                            gun-upgrade-ammo-yellow
                                                            gun-upgrade-ammo-blue
                                                            gun-upgrade-ammo-dark
                                                            ))
            (logior! (-> *game-info* purchase-secrets) (-> *game-info* secrets))
            (logior! (-> *game-info* vehicles) (game-vehicles v-fox v-mirage v-x-ride))
            )
          (else
            ;; not side mish
            (set! (-> *speedrun-info* override-vehicle) (the-as vehicle-type 0)) ;; override vehicles should only apply for side missions
            )
          )
        (set-percent-warped! #f)
        (set! (-> *speedrun-info* avg-speed) 0.0)
        (start! (the-as speedrun-timer (ppointer->process (-> *speedrun-manager* 0 timer))))
        )
      side-mish?
      tsk
      )
    )
  (none)
  )

(defconstant HERO_MODE_SECRETS
  (game-secrets hero-mode
                endless-ammo
                invulnerable
                endless-dark
                endless-light
                unlimited-turbos
