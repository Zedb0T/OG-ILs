                gun-upgrade-red-2
                gun-upgrade-red-3
                gun-upgrade-yellow-1
                gun-upgrade-yellow-2
                gun-upgrade-yellow-3
                gun-upgrade-blue-1
                gun-upgrade-blue-2
                gun-upgrade-blue-3
                gun-upgrade-dark-1
                gun-upgrade-dark-2
                gun-upgrade-dark-3
                gun-upgrade-ammo-red
                gun-upgrade-ammo-yellow
                gun-upgrade-ammo-blue
                gun-upgrade-ammo-dark))

(defconstant HERO_MODE_FEATURES
