    (("pb-time-desert-rescue-bbush") (set! (-> obj pb-time-desert-rescue-bbush) (file-stream-read-float file)))
    (("pb-time-city-jetboard-bbush") (set! (-> obj pb-time-city-jetboard-bbush) (file-stream-read-float file)))
    (("pb-time-desert-bbush-destroy-interceptors") (set! (-> obj pb-time-desert-bbush-destroy-interceptors) (file-stream-read-float file)))
    (("pb-time-wascity-pre-game-2") (set! (-> obj pb-time-wascity-pre-game-2) (file-stream-read-float file)))
    (("pb-time-wascity-gungame-2") (set! (-> obj pb-time-wascity-gungame-2) (file-stream-read-float file)))
    (("pb-time-city-power-game-2") (set! (-> obj pb-time-city-power-game-2) (file-stream-read-float file)))
